--- /dev/null
+++ b/tui_gateway/fleet_tui_hooks.py
@@ -0,0 +1,78 @@
+"""Default-off bridge from the TUI session lifecycle into the fleet service.
+
+The host owns the integration flag: nothing is wired until an owner installs a
+:class:`FleetTuiHooks` via :func:`set_fleet_tui_hooks`. The bridge is
+best-effort on purpose — the HOST session path must never break because of the
+fleet side — while the service itself stays fail-closed (it simply declines
+operations when not ready or not associated).
+"""
+from __future__ import annotations
+
+import contextlib
+import logging
+from typing import Any
+
+from hermes_cli.fleet_tui_session import FleetTuiSessionService
+
+logger = logging.getLogger(__name__)
+
+#: Host close reasons → closed wire reason codes (D4). Unknown reasons fall
+#: back to the generic ``session_end``.
+_END_REASON_MAP = {"tui_shutdown": "tui_exit"}
+
+
+class FleetTuiHooks:
+    """Thin, never-raising adapter over an injected session service."""
+
+    def __init__(self, service: FleetTuiSessionService) -> None:
+        if type(service) is not FleetTuiSessionService:
+            raise TypeError("service must be an exact FleetTuiSessionService")
+        self._service = service
+
+    def note_session_end(self, end_reason: str) -> None:
+        reason = _END_REASON_MAP.get(str(end_reason), "session_end")
+        with contextlib.suppress(Exception):
+            self._service.session_ended(reason)
+
+    def note_status(self, status: str) -> None:
+        with contextlib.suppress(Exception):
+            self._service.session_status_changed(status)
+
+
+_hooks: FleetTuiHooks | None = None
+
+
+def set_fleet_tui_hooks(hooks: FleetTuiHooks | None) -> None:
+    """Install (or clear) the process hooks. Default is ``None`` = disabled."""
+    global _hooks
+    if hooks is not None and type(hooks) is not FleetTuiHooks:
+        raise TypeError("hooks must be a FleetTuiHooks or None")
+    _hooks = hooks
+
+
+def get_fleet_tui_hooks() -> FleetTuiHooks | None:
+    return _hooks
+
+
+def note_session_end(end_reason: str) -> None:
+    """Funnel-safe note: no-op when disabled; never raises."""
+    hooks = _hooks
+    if hooks is None:
+        return
+    try:
+        hooks.note_session_end(end_reason)
+    except Exception:  # pragma: no cover - belt and braces for the host path
+        logger.debug("fleet session-end hook failed", exc_info=True)
+
+
+def note_status(status: str) -> None:
+    hooks = _hooks
+    if hooks is None:
+        return
+    try:
+        hooks.note_status(status)
+    except Exception:  # pragma: no cover
+        logger.debug("fleet status hook failed", exc_info=True)
+
+
+__all__ = ["FleetTuiHooks", "get_fleet_tui_hooks", "note_session_end", "note_status", "set_fleet_tui_hooks"]

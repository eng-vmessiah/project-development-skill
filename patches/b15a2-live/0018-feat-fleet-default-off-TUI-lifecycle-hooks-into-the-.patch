             logger.debug("failed waiting for session turn thread", exc_info=True)
     if end_reason != "tui_shutdown":
         _settle_isolated_turn_before_close(session)
-    _teardown_session(session, end_reason=end_reason)
+    try:
+        _teardown_session(session, end_reason=end_reason)
+    finally:
+        # Best-effort, default-off lifecycle note: no-op unless an owner
+        # installed fleet hooks; never raises into the host close path.
+        # Lazy import: this function is also rebound with ``server`` globals
+        # (``bind_module``), which never publishes imported module objects.
+        with contextlib.suppress(Exception):
+            from tui_gateway import fleet_tui_hooks
+
+            fleet_tui_hooks.note_session_end(end_reason)
     return True
 
 

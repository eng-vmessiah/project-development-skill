+"""RED-first tests for the default-off TUI lifecycle → fleet hooks (B15a.2, S4).
+
+The hooks are best-effort by design: they must never break the host session
+path; the fleet service itself stays fail-closed. The single close funnel
+(``session_lifecycle._teardown_popped_session``) is the only instrumented
+point, and with no hooks installed the funnel is byte-for-byte unchanged.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli.fleet_activation import FleetActivationOwner
+from hermes_cli.fleet_observer import FleetObserverConfig, FleetObserverHub, FleetObserverScope
+from hermes_cli.fleet_tui_session import FleetTuiSessionService, TuiActiveSession
+from hermes_cli.fleet_tui_wire import FleetTuiWireError
+from tui_gateway import fleet_tui_hooks, session_lifecycle
+
+OBSERVER = "tui.observer-1"
+OWNER = "owner.alpha"
+S1 = "session.alpha-1"
+
+
+def _build() -> SimpleNamespace:
+    owner = FleetActivationOwner("issuer.one", OWNER, enabled=True, wired=True)
+    assert owner.activate() is True and owner.ready
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True))
+    hub.activate()
+    resolver = lambda: TuiActiveSession(S1, OWNER, "acct.main", "ws.here")  # noqa: E731
+    svc = FleetTuiSessionService(owner, hub, observer_ref=OBSERVER, resolve_active_session=resolver)
+    return SimpleNamespace(owner=owner, hub=hub, svc=svc)
+
+
+@pytest.fixture()
+def env():
+    e = _build()
+    e.hooks = fleet_tui_hooks.FleetTuiHooks(e.svc)
+    fleet_tui_hooks.set_fleet_tui_hooks(e.hooks)
+    yield e
+    fleet_tui_hooks.set_fleet_tui_hooks(None)
+
+
+def _code(fn):
+    with pytest.raises(FleetTuiWireError) as exc:
+        fn()
+    return exc.value.code
+
+
+def _events(env):
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    return [e.event_type for e in env.hub.replay(scope, None).events]
+
+
+def test_hooks_registry_defaults_and_type_gate():
+    fleet_tui_hooks.set_fleet_tui_hooks(None)
+    assert fleet_tui_hooks.get_fleet_tui_hooks() is None
+    fleet_tui_hooks.note_session_end("tui_shutdown")  # no-op, must not raise
+    fleet_tui_hooks.note_status("observing")  # no-op
+    with pytest.raises(TypeError):
+        fleet_tui_hooks.set_fleet_tui_hooks(object())
+    with pytest.raises(TypeError):
+        fleet_tui_hooks.FleetTuiHooks(object())
+
+
+def test_note_session_end_ends_association_and_maps_reason(env):
+    env.svc.activate()
+    assert env.svc.session_status_changed("observing") is True
+    fleet_tui_hooks.note_session_end("tui_shutdown")  # → tui_exit
+    assert _code(env.svc.status) == "association_stale"
+    assert _events(env) == ["session.registered", "session.status_changed", "session.ended"]
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    ended = [e for e in env.hub.replay(scope, None).events if e.event_type == "session.ended"]
+    assert ended[-1].payload.get("reason") == "tui_exit"
+
+
+def test_unknown_end_reason_maps_to_session_end(env):
+    env.svc.activate()
+    fleet_tui_hooks.note_session_end("idle_timeout")
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    ended = [e for e in env.hub.replay(scope, None).events if e.event_type == "session.ended"]
+    assert ended and ended[-1].payload.get("reason") == "session_end"
+
+
+def test_hooks_never_raise_without_association_or_identity(env):
+    fleet_tui_hooks.note_session_end("tui_shutdown")  # no association → no-op, no raise
+    env.owner.deactivate()
+    fleet_tui_hooks.note_session_end("tui_shutdown")  # not ready → no-op, no raise
+    fleet_tui_hooks.note_status("observing")
+
+
+def test_close_funnel_fires_hook(env, monkeypatch):
+    env.svc.activate()
+    calls: list[str] = []
+    monkeypatch.setattr(session_lifecycle, "_settle_isolated_turn_before_close", lambda session: None)
+    monkeypatch.setattr(session_lifecycle, "_teardown_session",
+                        lambda session, *, end_reason: calls.append(end_reason))
+    assert session_lifecycle._teardown_popped_session({"last_active": 0.0}, end_reason="tui_shutdown") is True
+    assert calls == ["tui_shutdown"]
+    assert _code(env.svc.status) == "association_stale"
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    ended = [e for e in env.hub.replay(scope, None).events if e.event_type == "session.ended"]
+    assert ended and ended[-1].payload.get("reason") == "tui_exit"
+
+
+def test_funnel_noop_without_hooks(monkeypatch):
+    fleet_tui_hooks.set_fleet_tui_hooks(None)
+    monkeypatch.setattr(session_lifecycle, "_settle_isolated_turn_before_close", lambda session: None)
+    monkeypatch.setattr(session_lifecycle, "_teardown_session", lambda session, *, end_reason: None)
+    assert session_lifecycle._teardown_popped_session({}, end_reason="tui_close") is True
+    assert session_lifecycle._teardown_popped_session(None, end_reason="tui_close") is False
+
+
+def test_close_funnel_via_server_rebound_copy(env, monkeypatch):
+    """The runtime path: ``bind_module`` re-creates the funnel with server globals."""
+    from tui_gateway import server
+
+    env.svc.activate()
+    calls: list[str] = []
+    monkeypatch.setattr(server, "_settle_isolated_turn_before_close", lambda session: None)
+    monkeypatch.setattr(server, "_teardown_session", lambda session, *, end_reason: calls.append(end_reason))
+    assert server._teardown_popped_session({"last_active": 0.0}, end_reason="tui_shutdown") is True
+    assert calls == ["tui_shutdown"]
+    assert _code(env.svc.status) == "association_stale"
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    ended = [e for e in env.hub.replay(scope, None).events if e.event_type == "session.ended"]
+    assert ended and ended[-1].payload.get("reason") == "tui_exit"
+
+
+def test_restart_invalidates_old_cursors(env):
+    started = env.svc.activate()
+    restarted = _build().svc  # fresh process: new service, new cursor secret
+    restarted.activate()
+    assert _code(lambda: restarted.replay(started["cursor"])) == "invalid_provenance"

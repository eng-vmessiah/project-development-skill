+class FleetPrincipalResolver:
+    """Framework-neutral adapter for an owner-verified principal.
+
+    Input is an object supplied by a server owner after authentication and
+    authorization. Strings, mappings, and absent input are never interpreted
+    as identity claims.
+    """
+
+    def __init__(self, resolver: Callable[[Any], FleetPrincipal | None], *,
+                 owner: FleetActivationOwner | None = None) -> None:
+        if not callable(resolver):
+            raise FleetActivationError("principal resolver must be callable")
+        if owner is None:
+            raise FleetActivationNotReady("principal resolver requires an owner")
+        if not isinstance(owner, FleetActivationOwner):
+            raise FleetActivationError("resolver owner must be a FleetActivationOwner")
+        self._resolver, self._owner = resolver, owner
+
+    def resolve(self, verified_context: Any) -> FleetPrincipal | None:
+        if self._owner is None:
+            return None
+        if verified_context is None or isinstance(verified_context, (str, bytes, bytearray, Mapping)):
+            return None
+        try:
+            principal = self._resolver(verified_context)
+        except Exception:
+            return None
+        if type(principal) is not FleetPrincipal:
+            return None
+        # Direct construction is intentionally authority-free.  The configured
+        # owner must validate the current epoch and its own issuance marker;
+        # provenance alone is never accepted as identity validation.
+        if principal._authority is None or principal._activation_epoch is None:
+            return None
+        try:
+            self._owner.validate_principal(principal)
+        except (FleetActivationError, FleetActivationNotReady):
+            return None
+        return principal
+
+

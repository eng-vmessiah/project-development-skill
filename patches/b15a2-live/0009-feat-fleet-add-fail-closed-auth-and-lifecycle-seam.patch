+def test_principal_seam_never_turns_api_key_into_identity():
+    owner = FleetActivationOwner("server", "owner", enabled=True, wired=True)
+    assert owner.activate()
+    principal = owner.issue_principal("observer")
+    resolver = FleetPrincipalResolver(lambda context: principal, owner=owner)
+    adapter = APIServerAdapter(PlatformConfig(extra={"key": "caller-key"}),
+                               fleet_principal_resolver=resolver,
+                               fleet_activation_owner=owner)
+    assert adapter._resolve_fleet_principal("caller-key") is None
+    assert adapter._resolve_fleet_principal({"subject": "observer"}) is None
+    assert adapter._resolve_fleet_principal(SimpleNamespace(server_verified=True)) == principal
+    assert adapter._resolve_fleet_principal(SimpleNamespace(subject="attacker")) == principal
+
+
+def test_principal_seam_fails_closed_for_missing_or_malformed_resolver():
+    adapter = _adapter({"key": "caller-key"})
+    assert adapter._resolve_fleet_principal(SimpleNamespace()) is None
+    owner = FleetActivationOwner("server", "owner", enabled=True, wired=True)
+    assert owner.activate()
+    adapter._fleet_principal_resolver = FleetPrincipalResolver(lambda _: {"subject": "bad"}, owner=owner)
+    assert adapter._resolve_fleet_principal(SimpleNamespace()) is None
+    adapter._fleet_principal_resolver = FleetPrincipalResolver(lambda _: FleetPrincipal(
+        "server", "observer", "owner", "local", (CAPABILITY_OBSERVE,)), owner=owner)
+    assert adapter._resolve_fleet_principal(SimpleNamespace()) is None
+
+
+def test_lifecycle_hook_requires_typed_ready_objects_and_allowlisted_metadata():
+    owner = FleetActivationOwner("server", "owner", enabled=True, wired=True)
+    assert owner.activate()
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True))
+    assert hub.activate()
+    principal = owner.issue_principal("observer")
+    binding = owner.issue_binding("observer")
+    publisher = FleetLifecyclePublisher(hub, owner, binding)
+    adapter = APIServerAdapter(PlatformConfig(), fleet_activation_owner=owner,
+                               fleet_lifecycle_publisher=publisher,
+                               fleet_activation_binding=binding)
+    received = []
+    scope = FleetObserverScope("api_server", "observer", "observer")
+    subscription = hub.subscribe(scope, received.append)
+    assert adapter._publish_fleet_session_lifecycle(
+        publisher=publisher, principal=principal, binding=binding,
+        event_type="session.ended", payload={"reason": "completed"})
+    assert received and received[0].payload == {"reason": "completed"}
+    hub.unsubscribe(subscription)
+    assert adapter._publish_fleet_session_lifecycle(
+        publisher=publisher, principal=principal, binding=binding,
+        event_type="run.raw", payload={"prompt": "secret"}) is None
+    assert adapter._publish_fleet_session_lifecycle(
+        publisher=None, principal=principal, binding=binding,
+        event_type="session.ended", payload={"reason": "completed"}) is None
+

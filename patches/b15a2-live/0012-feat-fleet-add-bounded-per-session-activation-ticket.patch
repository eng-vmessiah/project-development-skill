 def owner(**changes):
@@ -211,3 +212,56 @@ def test_deactivation_cannot_race_a_publication():
     assert result == ["event"] and deactivated == [True]
     with pytest.raises(FleetActivationNotReady): publisher.publish(
         p, "session.status_changed", FleetObserverScope("p", "i"), {"status": "ok"})
+
+
+def test_session_activation_requires_ticket_possession_and_one_shot_consume():
+    now = [10.0]
+    o = active_owner(); p = o.issue_principal("observer")
+    registry = FleetSessionActivationRegistry(o, clock=lambda: now[0], ticket_ttl_seconds=5)
+    ticket = registry.activate(p, "session")
+    with pytest.raises(FleetActivationError): registry.binding_for(p, "session")
+    with pytest.raises(FleetActivationError): registry.binding_for(
+        FleetActivationTicket("x" * 16), p, "session")
+    binding = registry.consume(ticket, p, "session")
+    assert registry.binding_for(ticket, p, "session") == binding
+    with pytest.raises(FleetActivationError): registry.consume(ticket, p, "session")
+    with pytest.raises(FleetActivationError): registry.binding_for(ticket, p, "other")
+    with pytest.raises(FleetActivationError): registry.binding_for(ticket, o.issue_principal("other"), "session")
+
+
+def test_session_activation_sweeps_expired_entries_before_capacity_check(monkeypatch):
+    now = [100.0]
+    o = active_owner(); p = o.issue_principal("observer")
+    registry = FleetSessionActivationRegistry(o, clock=lambda: now[0], ticket_ttl_seconds=1)
+    monkeypatch.setattr("hermes_cli.fleet_session_activation.MAX_ENTRIES", 1)
+    registry.activate(p, "expired")
+    now[0] = 101.0
+    registry.activate(p, "replacement")
+    assert len(registry._entries) == 1
+
+
+def test_session_activation_rejects_full_registry_without_eviction(monkeypatch):
+    o = active_owner(); p = o.issue_principal("observer")
+    registry = FleetSessionActivationRegistry(o, clock=lambda: 100.0)
+    monkeypatch.setattr("hermes_cli.fleet_session_activation.MAX_ENTRIES", 1)
+    registry.activate(p, "first")
+    with pytest.raises(FleetActivationNotReady): registry.activate(p, "second")
+    assert set(registry._entries) == {"first"}
+
+
+def test_session_activation_consumed_entry_remains_revocable_until_expiry():
+    now = [100.0]
+    o = active_owner(); p = o.issue_principal("observer")
+    registry = FleetSessionActivationRegistry(o, clock=lambda: now[0], ticket_ttl_seconds=5)
+    ticket = registry.activate(p, "session")
+    registry.consume(ticket, p, "session")
+
+    assert not registry.active("session")
+    assert registry.revoke(p, "session")
+    assert not registry.active("session")
+    with pytest.raises(FleetActivationError): registry.binding_for(ticket, p, "session")
+    assert not registry.revoke(p, "session")
+
+    now[0] = 105.0
+    registry.active("other")
+    assert "session" not in registry._entries

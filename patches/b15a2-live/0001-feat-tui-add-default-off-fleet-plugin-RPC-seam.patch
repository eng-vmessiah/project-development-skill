 logger = logging.getLogger(__name__)
 
@@ -91,6 +92,7 @@ from tui_gateway.render import make_stream_renderer, render_diff, render_message
 
 _sessions: dict[str, dict] = {}
 _methods: dict[str, callable] = {}
+_plugin_rpc_registry = PluginRpcRegistry()
 _db = None
 _db_error: str | None = None
 _stdout_lock = threading.Lock()
@@ -886,6 +888,33 @@ def register_method(name: str, fn) -> None:
     _methods[name] = fn
 
 
+def register_plugin_rpc(
+    namespace: Any,
+    name: Any,
+    handler: Any,
+    *,
+    enabled: bool = False,
+) -> str:
+    """Register one host-approved plugin RPC behind an explicit flag.
+
+    Plugin RPCs are kept separate from the core decorator registry and can only
+    use the reserved ``fleet`` namespace. The public seam is default-off;
+    callers must pass the host's already-resolved integration flag.
+    """
+    return _plugin_rpc_registry.register(
+        namespace,
+        name,
+        handler,
+        enabled=enabled,
+        reserved=frozenset(_methods),
+    )
+
+
+def clear_plugin_rpcs_for_tests() -> None:
+    """Clear injected handlers for isolated dispatcher tests."""
+    _plugin_rpc_registry.clear()
+
+
 def method(name: str):
     def dec(fn):
         register_method(name, fn)

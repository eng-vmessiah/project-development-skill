+
+def lifecycle():
+    o = active_owner()
+    p = o.issue_principal("observer")
+    h = hub()
+    b = o.issue_binding("observer")
+    publisher = FleetLifecyclePublisher(h, o, b)
+    registry = FleetSessionActivationRegistry(o)
+    return o, p, registry, FleetSessionLifecycleIntegration(o, registry, publisher)
+
+
+def test_lifecycle_status_is_authoritative_and_failed_publish_preserves_it(monkeypatch):
+    _, p, registry, integration = lifecycle()
+    ticket = registry.activate(p, "session")
+    integration.attach(ticket, p, "session", status="starting")
+    assert integration._attached["session"][2] == "starting"
+
+    integration.status_changed(p, "session", "ready")
+    assert integration._attached["session"][2] == "ready"
+
+    def fail(*args, **kwargs):
+        raise RuntimeError("opaque publisher failure")
+
+    monkeypatch.setattr(FleetLifecyclePublisher, "publish", fail)
+    with pytest.raises(FleetActivationError, match="status update failed") as error:
+        integration.status_changed(p, "session", "broken")
+    assert "opaque publisher failure" not in str(error.value)
+    assert integration._attached["session"][2] == "ready"
+    assert integration.active("session")
+
+
+def test_lifecycle_ended_failed_publish_still_revokes_and_detaches(monkeypatch):
+    _, p, registry, integration = lifecycle()
+    ticket = registry.activate(p, "session")
+    integration.attach(ticket, p, "session")
+
+    def fail(*args, **kwargs):
+        raise RuntimeError("secret")
+
+    monkeypatch.setattr(FleetLifecyclePublisher, "publish", fail)
+    with pytest.raises(FleetActivationError, match="termination failed") as error:
+        integration.ended(p, "session", "closed")
+    assert "secret" not in str(error.value)
+    assert not integration.active("session")
+    assert not registry.active("session")
+    assert "session" in registry._revoked
+
+
+def test_lifecycle_forged_principal_cannot_teardown_attached_session():
+    _, p, registry, integration = lifecycle()
+    ticket = registry.activate(p, "session")
+    integration.attach(ticket, p, "session")
+    forged = FleetPrincipal(p.issuer_ref, p.subject_ref, p.owner_ref, p.provider, p.scopes)
+
+    for teardown in (
+        lambda: integration.ended(forged, "session", "closed"),
+        lambda: integration.detach(forged, "session"),
+    ):
+        with pytest.raises(FleetActivationError, match="not owner-issued"):
+            teardown()
+        assert integration.active("session")
+
+    integration.ended(p, "session", "closed")
+    assert not integration.active("session")
+
+
+def test_registered_if_attached_is_idempotent_but_validates_event_data(monkeypatch):
+    _, p, registry, integration = lifecycle()
+    ticket = registry.activate(p, "session")
+    calls = []
+    original = FleetLifecyclePublisher.publish
+
+    def record(self, *args, **kwargs):
+        calls.append(args[1] if len(args) > 1 else None)
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(FleetLifecyclePublisher, "publish", record)
+    integration.attach(ticket, p, "session")
+    assert calls == ["session.registered"]
+    assert integration.registered_if_attached(p, "session", status="later", metadata={"ui": "test"})
+    assert calls == ["session.registered"]
+    with pytest.raises(FleetActivationError):
+        integration.registered_if_attached(p, "session", metadata={"token": "must reject"})

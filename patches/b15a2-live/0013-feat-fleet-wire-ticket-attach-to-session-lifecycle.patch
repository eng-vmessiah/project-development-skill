--- /dev/null
+++ b/hermes_cli/fleet_session_lifecycle.py
@@ -0,0 +1,245 @@
+"""Explicit, owner-authenticated session lifecycle integration seam.
+
+This module is intentionally inert until an already-ready owner, activation
+registry, and lifecycle publisher are injected by an explicit caller.
+"""
+from __future__ import annotations
+
+from threading import RLock
+from typing import Any, Mapping
+
+from .fleet_activation import (
+    OWNERSHIP_MODE,
+    FleetActivationBinding,
+    FleetActivationError,
+    FleetActivationNotReady,
+    FleetActivationOwner,
+    FleetLifecyclePublisher,
+    FleetPrincipal,
+)
+from .fleet_observer import FleetObserverScope
+from .fleet_session_activation import FleetActivationTicket, FleetSessionActivationRegistry
+
+MAX_VALUE_LENGTH = 256
+MAX_METADATA_FIELDS = 16
+MAX_METADATA_DEPTH = 2
+_FORBIDDEN = frozenset({
+    "password", "pass", "authorization", "auth", "cookie", "secret", "token",
+    "api_key", "apikey", "private_key", "privatekey", "credential", "credentials",
+    "prompt", "history", "message", "messages", "tool", "tools", "provider",
+    "terminal", "filesystem", "path", "file", "files", "content", "issuer",
+    "subject", "owner", "principal", "identity",
+})
+
+
+def _bounded_string(value: Any, name: str) -> str:
+    if type(value) is not str or not value or len(value) > MAX_VALUE_LENGTH:
+        raise FleetActivationError(f"{name} must be a bounded string")
+    if any(ord(c) < 32 or ord(c) == 127 for c in value):
+        raise FleetActivationError(f"{name} must be a bounded string")
+    return value
+
+
+def _safe_metadata(value: Any) -> dict[str, Any]:
+    if value is None:
+        return {}
+    if not isinstance(value, Mapping) or len(value) > MAX_METADATA_FIELDS:
+        raise FleetActivationError("metadata must be a bounded mapping")
+
+    def clean(item: Any, depth: int) -> Any:
+        if depth > MAX_METADATA_DEPTH:
+            raise FleetActivationError("metadata is too deep")
+        if isinstance(item, str):
+            return _bounded_string(item, "metadata value")
+        if item is None or type(item) is bool or type(item) is int or type(item) is float:
+            return item
+        if isinstance(item, Mapping) and len(item) <= MAX_METADATA_FIELDS:
+            if any(type(k) is not str or k.casefold() in _FORBIDDEN for k in item):
+                raise FleetActivationError("metadata contains unavailable values")
+            return {k: clean(v, depth + 1) for k, v in item.items()}
+        raise FleetActivationError("metadata contains unavailable values")
+
+    if any(type(key) is not str or key.casefold() in _FORBIDDEN for key in value):
+        raise FleetActivationError("metadata contains unavailable values")
+    return {key: clean(item, 0) for key, item in value.items()}
+
+
+class FleetSessionLifecycleIntegration:
+    """Map one-shot activation tickets to authoritative session lifecycle."""
+
+    OWNERSHIP_MODE = OWNERSHIP_MODE
+
+    def __init__(self, owner: FleetActivationOwner,
+                 registry: FleetSessionActivationRegistry,
+                 publisher: FleetLifecyclePublisher, *, max_sessions: int = 1024) -> None:
+        if type(owner) is not FleetActivationOwner:
+            raise TypeError("owner must be an exact FleetActivationOwner")
+        if not owner.ready:
+            raise FleetActivationNotReady("fleet activation owner is not ready")
+        if type(registry) is not FleetSessionActivationRegistry or registry.owner is not owner:
+            raise TypeError("registry must be owned by the exact owner")
+        if type(publisher) is not FleetLifecyclePublisher:
+            raise TypeError("publisher must be an exact FleetLifecyclePublisher")
+        if getattr(publisher, "_owner", None) is not owner:
+            raise TypeError("publisher must be owned by the exact owner")
+        if type(max_sessions) is not int or isinstance(max_sessions, bool) or not 1 <= max_sessions <= 1024:
+            raise ValueError("max_sessions must be between 1 and 1024")
+        self._owner = owner
+        self._registry = registry
+        self._publisher = publisher
+        self._max_sessions = max_sessions
+        # The attached record is the authoritative lifecycle state.  Keep the
+        # last successfully published status alongside the authenticated
+        # principal and binding; callers must not infer state from the hub.
+        self._attached: dict[str, tuple[FleetPrincipal, FleetActivationBinding, str]] = {}
+        self._lock = RLock()
+
+    @property
+    def owner(self) -> FleetActivationOwner:
+        return self._owner
+
+    def _scope(self, binding: FleetActivationBinding, session_ref: str) -> FleetObserverScope:
+        return FleetObserverScope(self._owner.owner_ref, binding.observer_ref, session_ref=session_ref)
+
+    def _publish(self, principal: FleetPrincipal, event: str,
+                 binding: FleetActivationBinding, session_ref: str, payload: Mapping[str, Any]) -> Any:
+        return self._publisher.publish(principal, event, binding, self._scope(binding, session_ref), dict(payload))
+
+    def attach(self, ticket: FleetActivationTicket, principal: FleetPrincipal, session_ref: str,
+               *, status: str = "active", metadata: Mapping[str, Any] | None = None) -> FleetActivationBinding:
+        if type(ticket) is not FleetActivationTicket or type(principal) is not FleetPrincipal:
+            raise FleetActivationError("ticket and principal are malformed")
+        if type(session_ref) is not str or not session_ref:
+            raise FleetActivationError("session_ref is malformed")
+        clean_status = _bounded_string(status, "status")
+        clean_metadata = _safe_metadata(metadata)
+        with self._lock:
+            if session_ref in self._attached:
+                raise FleetActivationError("session is already attached")
+            if len(self._attached) >= self._max_sessions:
+                raise FleetActivationError("lifecycle session capacity is exhausted")
+            binding = self._registry.consume(ticket, principal, session_ref)
+            try:
+                self._publish(principal, "session.registered", binding, session_ref,
+                              {"status": clean_status, "metadata": clean_metadata})
+            except Exception as exc:
+                try:
+                    self._registry.revoke(principal, session_ref)
+                except Exception:
+                    pass
+                raise FleetActivationError("session lifecycle registration failed") from exc
+            self._attached[session_ref] = (principal, binding, clean_status)
+            return binding
+
+    def _attached_binding(self, principal: FleetPrincipal, session_ref: str) -> FleetActivationBinding:
+        if type(principal) is not FleetPrincipal or type(session_ref) is not str:
+            raise FleetActivationError("session lifecycle identity is malformed")
+        try:
+            self._owner.validate_principal(principal)
+        except Exception:
+            raise FleetActivationError("session lifecycle identity is not owner-issued") from None
+
+        item = self._attached.get(session_ref)
+        if item is None:
+            raise FleetActivationError("session is not attached to this principal")
+
+        attached_principal = item[0]
+        try:
+            same_issued_identity = (
+                attached_principal._authority is principal._authority
+                and attached_principal._activation_epoch == principal._activation_epoch
+                and (
+                    attached_principal.issuer_ref,
+                    attached_principal.subject_ref,
+                    attached_principal.owner_ref,
+                    attached_principal.provider,
+                    attached_principal.scopes,
+                ) == (
+                    principal.issuer_ref,
+                    principal.subject_ref,
+                    principal.owner_ref,
+                    principal.provider,
+                    principal.scopes,
+                )
+                and attached_principal.issuer_ref == self._owner.issuer_ref
+                and attached_principal.owner_ref == self._owner.owner_ref
+            )
+        except (AttributeError, TypeError):
+            same_issued_identity = False
+        if not same_issued_identity:
+            raise FleetActivationError("session is not attached to this principal")
+        return item[1]
+
+    def status_changed(self, principal: FleetPrincipal, session_ref: str, status: str) -> None:
+        clean_status = _bounded_string(status, "status")
+        with self._lock:
+            binding = self._attached_binding(principal, session_ref)
+            try:
+                self._publish(principal, "session.status_changed", binding, session_ref,
+                              {"status": clean_status})
+            except Exception as exc:
+                raise FleetActivationError("session lifecycle status update failed") from exc
+            current = self._attached.get(session_ref)
+            if current is None or current[0] != principal or current[1] != binding:
+                raise FleetActivationError("session lifecycle status update failed")
+            self._attached[session_ref] = (current[0], current[1], clean_status)
+
+    def ended(self, principal: FleetPrincipal, session_ref: str, reason: str) -> None:
+        clean_reason = _bounded_string(reason, "reason")
+        with self._lock:
+            binding = self._attached_binding(principal, session_ref)
+            failed = False
+            try:
+                self._publish(principal, "session.ended", binding, session_ref, {"reason": clean_reason})
+            except Exception:
+                failed = True
+            finally:
+                try:
+                    self._registry.revoke(principal, session_ref)
+                except Exception:
+                    failed = True
+                self._attached.pop(session_ref, None)
+            if failed:
+                raise FleetActivationError("session lifecycle termination failed")
+
+    def detach(self, principal: FleetPrincipal, session_ref: str, reason: str = "detached") -> None:
+        clean_reason = _bounded_string(reason, "reason")
+        with self._lock:
+            binding = self._attached_binding(principal, session_ref)
+            failed = False
+            try:
+                self._publish(principal, "session.detached", binding, session_ref, {"reason": clean_reason})
+            except Exception:
+                failed = True
+            finally:
+                try:
+                    self._registry.revoke(principal, session_ref)
+                except Exception:
+                    failed = True
+                self._attached.pop(session_ref, None)
+            if failed:
+                raise FleetActivationError("session lifecycle termination failed")
+
+    def active(self, session_ref: str) -> bool:
+        with self._lock:
+            return type(session_ref) is str and session_ref in self._attached
+
+    def registered_if_attached(self, principal: FleetPrincipal, session_ref: str,
+                               status: str = "active", metadata: Mapping[str, Any] | None = None) -> bool:
+        """Validate an idempotent registration callback without republishing.
+
+        ``attach`` is authoritative and has already emitted
+        ``session.registered``.  This compatibility seam validates supplied
+        event data but never creates a duplicate event or mutates state.
+        """
+        clean_status = _bounded_string(status, "status")
+        clean_metadata = _safe_metadata(metadata)
+        with self._lock:
+            if (type(principal) is not FleetPrincipal or type(session_ref) is not str
+                    or not session_ref):
+                return False
+            item = self._attached.get(session_ref)
+            if item is None or item[0] != principal:
+                return False
+            _ = clean_status, clean_metadata
+            return True

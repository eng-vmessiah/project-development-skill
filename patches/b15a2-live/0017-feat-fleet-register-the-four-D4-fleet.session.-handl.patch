+"""RED-first tests for the D4 fleet.session.* seam registration (B15a.2, S3).
+
+Proves: default-off registration, atomic batch of the four approved names,
+wire-level canonical bounded errors, client-authority denial over the RPC
+path, handler exception isolation, and non-Fleet dispatch compatibility.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli.fleet_activation import FleetActivationOwner
+from hermes_cli.fleet_observer import FleetObserverConfig, FleetObserverHub
+from hermes_cli.fleet_tui_session import FleetTuiSessionService, TuiActiveSession
+from hermes_cli.fleet_tui_wire import WIRE_SCHEMA
+from tui_gateway import server
+from tui_gateway.fleet_tui_registration import FLEET_SESSION_METHODS, register_fleet_session_rpcs
+from tui_gateway.plugin_rpc import PluginRpcRegistrationError
+
+OBSERVER = "tui.observer-1"
+OWNER = "owner.alpha"
+S1 = "session.alpha-1"
+
+FOUR = ("fleet.session.activate", "fleet.session.status", "fleet.session.deactivate", "fleet.session.replay")
+
+
+@pytest.fixture()
+def svc():
+    owner = FleetActivationOwner("issuer.one", OWNER, enabled=True, wired=True)
+    assert owner.activate() is True and owner.ready
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True))
+    hub.activate()
+    resolver = lambda: TuiActiveSession(S1, OWNER, "acct.main", "ws.here")  # noqa: E731
+    return FleetTuiSessionService(owner, hub, observer_ref=OBSERVER, resolve_active_session=resolver)
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    server.clear_plugin_rpcs_for_tests()
+    yield
+    server.clear_plugin_rpcs_for_tests()
+
+
+def _call(method, params):
+    return server.handle_request({"id": 1, "method": method, "params": params})
+
+
+def test_registration_is_default_off(svc):
+    with pytest.raises(PluginRpcRegistrationError):
+        register_fleet_session_rpcs(svc, enabled=False)
+    assert _call("fleet.session.activate", {"schema_version": WIRE_SCHEMA})["error"]["code"] == -32601
+
+
+def test_enabled_registration_is_atomic_and_dispatches_all_four(svc):
+    names = register_fleet_session_rpcs(svc, enabled=True)
+    assert names == FOUR
+    assert FLEET_SESSION_METHODS == FOUR
+
+    activated = _call("fleet.session.activate", {"schema_version": WIRE_SCHEMA})
+    result = activated["result"]
+    assert set(result) == {"schema_version", "association_ref", "subscriber_ref", "stream_epoch", "cursor", "snapshot"}
+    assert result["snapshot"]["state"] == "observing"
+
+    status = _call("fleet.session.status", {"schema_version": WIRE_SCHEMA})["result"]
+    assert status["snapshot"]["association_ref"] == result["association_ref"]
+
+    assert svc.session_status_changed("observing") is True
+    replay = _call("fleet.session.replay", {"schema_version": WIRE_SCHEMA, "cursor": result["cursor"]})["result"]
+    assert [e["event_type"] for e in replay["events"]] == ["session.status_changed"]
+
+    detached = _call("fleet.session.deactivate", {"schema_version": WIRE_SCHEMA})["result"]
+    assert detached == {"schema_version": WIRE_SCHEMA, "status": "detached"}
+
+
+def test_client_authority_denied_over_rpc(svc):
+    register_fleet_session_rpcs(svc, enabled=True)
+    forged = _call("fleet.session.activate", {"schema_version": WIRE_SCHEMA, "session_id": "client-chosen"})
+    assert forged["result"] == {"schema_version": WIRE_SCHEMA, "error": {"code": "invalid_request"}}
+    bad_schema = _call("fleet.session.status", {"schema_version": "pd-fleet-tui:v9"})
+    assert bad_schema["result"]["error"]["code"] == "unsupported_schema"
+
+
+def test_wire_errors_are_canonical(svc):
+    register_fleet_session_rpcs(svc, enabled=True)
+    stale = _call("fleet.session.status", {"schema_version": WIRE_SCHEMA})
+    assert stale["result"] == {"schema_version": WIRE_SCHEMA, "error": {"code": "association_stale"}}
+    bad_cursor = _call("fleet.session.replay", {"schema_version": WIRE_SCHEMA, "cursor": "cur.nope"})
+    assert bad_cursor["result"]["error"]["code"] == "association_stale"
+
+
+def test_duplicate_registration_is_rejected_and_keeps_original(svc):
+    register_fleet_session_rpcs(svc, enabled=True)
+    with pytest.raises(PluginRpcRegistrationError):
+        register_fleet_session_rpcs(svc, enabled=True)
+    assert _call("fleet.session.activate", {"schema_version": WIRE_SCHEMA})["result"]["schema_version"] == WIRE_SCHEMA
+
+
+def test_handler_exception_is_isolated(svc):
+    def boom(rid, params):
+        raise RuntimeError("secret internals")
+
+    server.register_plugin_rpc_batch("fleet", [("session.explode", boom)], enabled=True)
+    resp = _call("fleet.session.explode", {})
+    assert resp["error"]["code"] == -32000
+    assert "secret" not in resp["error"]["message"]
+
+
+def test_non_fleet_dispatch_is_unchanged(svc):
+    before = _call("core.not_a_real_method", {})
+    register_fleet_session_rpcs(svc, enabled=True)
+    after = _call("core.not_a_real_method", {})
+    assert before == after  # byte-for-byte: unknown non-Fleet methods unchanged
+    assert after["error"]["code"] == -32601

+"""Host-side registration of the four approved D4 ``fleet.session.*`` handlers.
+
+The seam is default-off: callers must pass the host's already-resolved
+integration flag. Handlers are thin adapters over an injected
+:class:`FleetTuiSessionService`; wire-level failures become canonical bounded
+error payloads, and any unexpected exception is isolated by the dispatcher
+(never leaking internals to the client).
+"""
+from __future__ import annotations
+
+from typing import Any, Callable
+
+from hermes_cli.fleet_tui_session import FleetTuiSessionService
+from hermes_cli.fleet_tui_wire import (
+    FleetTuiWireError,
+    build_error,
+    parse_activate_request,
+    parse_deactivate_request,
+    parse_replay_request,
+    parse_status_request,
+)
+
+FLEET_SESSION_METHODS = (
+    "fleet.session.activate",
+    "fleet.session.status",
+    "fleet.session.deactivate",
+    "fleet.session.replay",
+)
+
+
+def _make_handler(service: FleetTuiSessionService,
+                  parse: Callable[[Any], dict[str, Any]],
+                  invoke: Callable[[FleetTuiSessionService, dict[str, Any]], dict[str, Any]]
+                  ) -> Callable[[Any, Any], dict]:
+    def handler(rid: Any, params: Any) -> dict:
+        from . import server
+        try:
+            request = parse(params)
+            response = invoke(service, request)
+        except FleetTuiWireError as exc:
+            return server._ok(rid, build_error(exc.code))
+        return server._ok(rid, response)
+
+    return handler
+
+
+def register_fleet_session_rpcs(service: FleetTuiSessionService, *, enabled: bool) -> tuple[str, ...]:
+    """Atomically register the four D4 handlers behind the host integration flag."""
+    from . import server
+
+    if type(service) is not FleetTuiSessionService:
+        raise TypeError("service must be an exact FleetTuiSessionService")
+    registrations = (
+        ("session.activate", _make_handler(service, parse_activate_request, lambda svc, req: svc.activate())),
+        ("session.status", _make_handler(service, parse_status_request, lambda svc, req: svc.status())),
+        ("session.deactivate", _make_handler(service, parse_deactivate_request, lambda svc, req: svc.deactivate())),
+        ("session.replay", _make_handler(service, parse_replay_request, lambda svc, req: svc.replay(req["cursor"]))),
+    )
+    return server.register_plugin_rpc_batch("fleet", registrations, enabled=enabled)
+
+
+__all__ = ["FLEET_SESSION_METHODS", "register_fleet_session_rpcs"]

-            except ReplayGap:
-                raise FleetTuiWireError("replay_gap") from None
+            except ReplayGap as gap:
+                # The hub can hit its own expiry check first (skewed/injected clocks):
+                # that condition is an expiry, not a continuity gap.
+                code = "cursor_expired" if "cursor has expired" in str(gap) else "replay_gap"
+                raise FleetTuiWireError(code) from None
             except FleetObserverError:
                 raise FleetTuiWireError("invalid_provenance") from None
             if result.gap is not None:
                 raise FleetTuiWireError("replay_gap")
             events = [self._wire_event(assoc, event) for event in result.events]
-            if events and result.next_cursor is not None:
-                next_cursor = self._encode_cursor(assoc.scope, result.next_cursor.stream_epoch,
-                                                  result.next_cursor.sequence, issued_at)
-            else:
-                next_cursor = cursor  # no advance: echo the client cursor unchanged
-            return build_replay_response(events=events, next_cursor=next_cursor)
+            if not events:
+                return build_replay_response(events=[], next_cursor=cursor)  # echo: no advance
+            if result.next_cursor is None:
+                return build_replay_response(events=events, next_cursor=cursor)
+            # Bounded pagination: serve the largest prefix that fits the envelope so a
+            # backlogged client always advances (never a dead-end retry of one cursor).
+            epoch_now = result.next_cursor.stream_epoch
+            low, high = 1, len(events)
+            while low < high:
+                mid = (low + high + 1) // 2
+                probe = self._encode_cursor(assoc.scope, epoch_now, result.events[mid - 1].sequence, issued_at)
+                try:
+                    build_replay_response(events=events[:mid], next_cursor=probe)
+                except FleetTuiWireError as exc:
+                    if exc.code != "payload_too_large":
+                        raise
+                    high = mid - 1
+                else:
+                    low = mid
+            next_cursor = self._encode_cursor(assoc.scope, epoch_now, result.events[low - 1].sequence, issued_at)
+            return build_replay_response(events=events[:low], next_cursor=next_cursor)
 

+# ── review fixes (S6): pagination, expiry mapping, identity-targeted end ─────
+
+def _clocked_service(clock):
+    owner = FleetActivationOwner("issuer.one", OWNER, enabled=True, wired=True)
+    assert owner.activate() is True and owner.ready
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True))
+    hub.activate()
+    return FleetTuiSessionService(owner, hub, observer_ref=OBSERVER,
+                                  resolve_active_session=lambda: _ctx(), clock=clock)
+
+
+def test_replay_paginates_bounded_batches(env):
+    started = env.svc.activate()
+    for _ in range(40):
+        assert env.svc.session_status_changed("observing") is True
+    cursor = started["cursor"]
+    seen = 0
+    batches = 0
+    for _ in range(10):
+        response = env.svc.replay(cursor)
+        batches += 1
+        if not response["events"]:
+            break
+        assert len(response["events"]) < 40  # a single batch must never exceed the envelope
+        seen += len(response["events"])
+        cursor = response["next_cursor"]
+    assert seen == 40
+    assert batches >= 2
+
+
+def test_replay_cursor_expiry_fails_closed():
+    from hermes_cli.fleet_tui_session import CURSOR_TTL_SECONDS
+    clock = {"now": 10_000.0}
+    svc = _clocked_service(lambda: clock["now"])
+    started = svc.activate()
+    clock["now"] += CURSOR_TTL_SECONDS + 1
+    assert _code(lambda: svc.replay(started["cursor"])) == "cursor_expired"
+
+
+def test_replay_hub_clock_expiry_maps_to_cursor_expired():
+    import time as _time
+    # The hub's own expiry check can fire first when clocks diverge; that is an
+    # expiry condition and must surface as cursor_expired, never replay_gap.
+    svc = _clocked_service(lambda: _time.time() - 1801)
+    started = svc.activate()
+    assert _code(lambda: svc.replay(started["cursor"])) == "cursor_expired"
+
+
+def test_replay_non_ascii_cursor_fails_closed(env):
+    import base64
+    env.svc.activate()
+    forged = "cur." + base64.urlsafe_b64encode("é-a-b-c-d-e".encode("utf-8")).decode("ascii")
+    assert _code(lambda: env.svc.replay(forged)) == "invalid_provenance"
+
+
+def test_session_ended_targets_named_session(env):
+    from hermes_cli.fleet_observer import FleetObserverScope
+    started = env.svc.activate()
+    env.state["session"] = S2  # the resolver has already moved on
+    assert env.svc.session_ended("session_end", session_ref=S1) is True
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    assert [e.event_type for e in env.hub.replay(scope, None).events] == ["session.registered", "session.ended"]
+    restarted = env.svc.activate()
+    assert restarted["association_ref"] != started["association_ref"]
+
+
+def test_session_ended_ignores_unrelated_or_invalid_refs(env):
+    env.svc.activate()
+    assert env.svc.session_ended("session_end", session_ref="session.other") is False
+    assert env.svc.session_ended("session_end", session_ref="bad ref!") is False
+    assert env.svc.status()["snapshot"]["state"] == "observing"  # association intact

     assert _code(lambda: restarted.replay(started["cursor"])) == "invalid_provenance"
+
+
+def test_close_funnel_passes_session_identity(env, monkeypatch):
+    env.svc.activate()
+    monkeypatch.setattr(session_lifecycle, "_settle_isolated_turn_before_close", lambda session: None)
+    monkeypatch.setattr(session_lifecycle, "_teardown_session", lambda session, *, end_reason: None)
+    # a close of an unrelated session is a no-op for the fleet association
+    assert session_lifecycle._teardown_popped_session({"_sid": "session.other"}, end_reason="tui_close") is True
+    assert env.svc.status()["snapshot"]["state"] == "observing"
+    # the associated session's close ends exactly that association
+    assert session_lifecycle._teardown_popped_session({"_sid": S1}, end_reason="tui_shutdown") is True
+    assert _code(env.svc.status) == "association_stale"

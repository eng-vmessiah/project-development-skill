+def test_replay_cursor_tamper_fails_closed(env):
+    started = env.svc.activate()
+    cursor = started["cursor"]
+    # Flip a character in the middle of the payload: guaranteed to change the
+    # decoded bytes (a last-character flip can land on unused base64 bits).
+    tampered = cursor[:10] + ("A" if cursor[10] != "A" else "B") + cursor[11:]
+    assert _code(lambda: env.svc.replay(tampered)) == "invalid_provenance"
+    assert _code(lambda: env.svc.replay("cur.not-base64!!")) == "invalid_provenance"
+
+
+def test_replay_cursor_scope_binding(env):
+    started = env.svc.activate()
+    env.svc.session_ended("session_end")
+    env.state["session"] = S2
+    env.svc.activate()
+    assert _code(lambda: env.svc.replay(started["cursor"])) == "cursor_stale"
+

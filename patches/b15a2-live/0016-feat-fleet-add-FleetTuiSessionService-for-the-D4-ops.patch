--- /dev/null
+++ b/tests/hermes_cli/test_fleet_tui_session.py
@@ -0,0 +1,218 @@
+"""Red-first tests for FleetTuiSessionService (B15a.2, S2).
+
+The service is the host-side composition of the four D4 ops over the existing
+activation/lifecycle/observer machinery. Nothing here performs live
+resolution: the active session and observer identity are injected/injected-
+resolver facts, as required by D7 (local/default-off/read-only).
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli.fleet_activation import FleetActivationNotReady, FleetActivationOwner
+from hermes_cli.fleet_observer import FleetObserverConfig, FleetObserverHub
+from hermes_cli.fleet_tui_session import FleetTuiSessionService, TuiActiveSession
+from hermes_cli.fleet_tui_wire import FleetTuiWireError, WIRE_SCHEMA
+
+OBSERVER = "tui.observer-1"
+OWNER = "owner.alpha"
+S1 = "session.alpha-1"
+S2 = "session.beta-2"
+
+
+def _ctx(session=S1, owner=OWNER):
+    return TuiActiveSession(session_ref=session, owner_ref=owner,
+                            profile_ref="acct.main", workspace_ref="ws.here")
+
+
+@pytest.fixture()
+def env():
+    owner = FleetActivationOwner("issuer.one", OWNER, enabled=True, wired=True)
+    assert owner.activate() is True and owner.ready
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True))
+    hub.activate()
+    assert hub.active is True
+    state: dict = {"session": S1, "owner": OWNER, "enabled": True}
+
+    def resolver():
+        if not state["enabled"]:
+            return None
+        return _ctx(state["session"], state["owner"])
+
+    svc = FleetTuiSessionService(owner, hub, observer_ref=OBSERVER, resolve_active_session=resolver)
+    return SimpleNamespace(owner=owner, hub=hub, state=state, svc=svc)
+
+
+def _code(fn):
+    with pytest.raises(FleetTuiWireError) as exc:
+        fn()
+    return exc.value.code
+
+
+# ── construction gates ───────────────────────────────────────────────────────
+
+
+def test_service_requires_ready_owner_and_enabled_hub():
+    owner = FleetActivationOwner("issuer.one", OWNER, enabled=True, wired=True)
+    hub_on = FleetObserverHub(FleetObserverConfig(enabled=True))
+    hub_on.activate()
+    with pytest.raises(FleetActivationNotReady):
+        FleetTuiSessionService(owner, hub_on, observer_ref=OBSERVER, resolve_active_session=lambda: None)
+    owner.activate()
+    assert owner.ready
+    hub_off = FleetObserverHub(FleetObserverConfig(enabled=False))
+    with pytest.raises(FleetActivationNotReady):
+        FleetTuiSessionService(owner, hub_off, observer_ref=OBSERVER, resolve_active_session=lambda: None)
+    with pytest.raises(FleetTuiWireError) as exc:
+        FleetTuiSessionService(owner, hub_on, observer_ref="bad token ref", resolve_active_session=lambda: None)
+    assert exc.value.code == "invalid_request"
+
+
+# ── activate ─────────────────────────────────────────────────────────────────
+
+
+def test_activate_happy_path_closed_shape(env):
+    resp = env.svc.activate()
+    assert set(resp) == {"schema_version", "association_ref", "subscriber_ref", "stream_epoch", "cursor", "snapshot"}
+    assert resp["schema_version"] == WIRE_SCHEMA
+    snap = resp["snapshot"]
+    assert set(snap) == {"association_ref", "stream_epoch", "snapshot_sequence", "boundary_ref", "state", "metadata_version"}
+    assert snap["association_ref"] == resp["association_ref"]
+    assert snap["state"] == "observing"
+    assert snap["snapshot_sequence"] >= 1  # session.registered is the first event
+    assert snap["metadata_version"] == 1
+
+
+def test_activate_is_idempotent_on_reconnect(env):
+    first = env.svc.activate()
+    second = env.svc.activate()
+    assert second["association_ref"] == first["association_ref"]
+    assert second["subscriber_ref"] == first["subscriber_ref"]
+    replay = env.svc.replay(second["cursor"])
+    assert replay["events"] == []  # no duplicate registration event
+
+
+def test_activate_denied_when_identity_unresolved(env):
+    env.state["enabled"] = False
+    assert _code(env.svc.activate) == "observer_not_authorized"
+
+
+def test_activate_denied_when_disabled_mid_stream(env):
+    env.owner.deactivate()
+    assert _code(env.svc.activate) == "observer_not_authorized"
+
+
+def test_activate_denied_when_context_owner_mismatches(env):
+    env.state["owner"] = "owner.beta"
+    assert _code(env.svc.activate) == "observer_not_authorized"
+
+
+def test_activate_denied_on_sensitive_ref(env):
+    env.state["session"] = "my-token-ref"
+    assert _code(env.svc.activate) == "observer_not_authorized"
+
+
+def test_single_active_session_enforced(env):
+    env.svc.activate()
+    env.state["session"] = S2
+    assert _code(env.svc.activate) == "association_stale"
+    env.state["session"] = S1
+    again = env.svc.activate()  # original active session still fine
+    assert again["snapshot"]["state"] == "observing"
+
+
+# ── status ───────────────────────────────────────────────────────────────────
+
+
+def test_status_requires_association(env):
+    assert _code(env.svc.status) == "association_stale"
+    first = env.svc.activate()
+    st = env.svc.status()
+    assert st["schema_version"] == WIRE_SCHEMA
+    assert st["snapshot"]["association_ref"] == first["association_ref"]
+    assert st["snapshot"]["stream_epoch"] == first["snapshot"]["stream_epoch"]
+
+
+# ── deactivate ───────────────────────────────────────────────────────────────
+
+
+def test_deactivate_detaches_and_is_idempotent(env):
+    first = env.svc.activate()
+    out = env.svc.deactivate()
+    assert out == {"schema_version": WIRE_SCHEMA, "status": "detached"}
+    assert env.svc.deactivate() == out  # idempotent
+    assert _code(env.svc.status) == "association_stale"
+    assert _code(lambda: env.svc.replay(first["cursor"])) == "association_stale"
+

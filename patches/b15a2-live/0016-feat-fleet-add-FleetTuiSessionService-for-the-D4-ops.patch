+def test_status_change_events_and_replay_chain(env):
+    started = env.svc.activate()
+    assert env.svc.session_status_changed("observing") is True
+    replay = env.svc.replay(started["cursor"])
+    assert len(replay["events"]) == 1
+    ev = replay["events"][0]
+    assert set(ev) == {"schema_version", "event_id", "event_type", "association_ref", "stream_epoch", "sequence", "payload"}
+    assert ev["event_type"] == "session.status_changed"
+    assert ev["payload"] == {"status": "observing", "metadata_version": 1}
+    assert ev["association_ref"] == started["association_ref"]
+    assert ev["sequence"] > started["snapshot"]["snapshot_sequence"]
+    again = env.svc.replay(replay["next_cursor"])
+    assert again["events"] == []
+    assert again["next_cursor"] == replay["next_cursor"]
+
+
+def test_session_ended_flow(env):
+    from hermes_cli.fleet_observer import FleetObserverScope
+
+    started = env.svc.activate()
+    assert env.svc.session_ended("session_end") is True
+    # strict semantics: replay serves the active association only
+    assert _code(env.svc.status) == "association_stale"
+    assert _code(lambda: env.svc.replay(started["cursor"])) == "association_stale"
+    # the ended event itself reached the hub stream (verified on the observer scope)
+    scope = FleetObserverScope(OWNER, OBSERVER, session_ref=S1)
+    result = env.hub.replay(scope, None)
+    assert [e.event_type for e in result.events] == ["session.registered", "session.ended"]
+    assert result.events[-1].payload.get("reason") == "session_end"
+
+
+def test_hooks_are_noop_without_association(env):
+    assert env.svc.session_status_changed("observing") is False
+    assert env.svc.session_ended("session_end") is False
+    with pytest.raises(FleetTuiWireError) as exc:
+        env.svc.session_status_changed("prompt secret")
+    assert exc.value.code == "invalid_event"
+    with pytest.raises(FleetTuiWireError) as exc:
+        env.svc.session_ended("freeform reason")
+    assert exc.value.code == "invalid_event"

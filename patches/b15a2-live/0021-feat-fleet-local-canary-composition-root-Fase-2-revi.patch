@@ -289,3 +289,21 @@ def test_session_ended_ignores_unrelated_or_invalid_refs(env):
     assert env.svc.session_ended("session_end", session_ref="session.other") is False
     assert env.svc.session_ended("session_end", session_ref="bad ref!") is False

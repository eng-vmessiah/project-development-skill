+"""Red-first tests for the closed D4 TUI Fleet wire codec (B15a.2, S1).
+
+The codec is pure validation/building for the ``pd-fleet-tui:v1`` wire defined
+in ``B15A-TUI-WIRE-CONTRACT.md`` (D4 approved). No session resolution, host
+state, transport, or external effect lives here.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli.fleet_tui_wire import (
+    ERROR_CODES,
+    EVENT_TYPES,
+    MAX_ENVELOPE_BYTES,
+    MAX_PAYLOAD_BYTES,
+    MAX_REPLAY_EVENTS,
+    METHOD_ACTIVATE,
+    METHOD_DEACTIVATE,
+    METHOD_REPLAY,
+    METHOD_STATUS,
+    WIRE_SCHEMA,
+    FleetTuiWireError,
+    build_activate_response,
+    build_deactivate_response,
+    build_error,
+    build_event_envelope,
+    build_replay_response,
+    build_snapshot,
+    build_status_response,
+    parse_activate_request,
+    parse_deactivate_request,
+    parse_replay_request,
+    parse_status_request,
+)
+
+REF = "assoc.a1-b2_c3"
+REF2 = "subscriber.one"
+
+
+def _code(exc: pytest.ExceptionInfo[FleetTuiWireError]) -> str:
+    return exc.value.code
+
+
+# ── constants ────────────────────────────────────────────────────────────────
+
+
+def test_wire_constants_are_the_approved_bounds():
+    assert WIRE_SCHEMA == "pd-fleet-tui:v1"
+    assert MAX_PAYLOAD_BYTES == 4096
+    assert MAX_ENVELOPE_BYTES == 8192
+    assert MAX_REPLAY_EVENTS == 100
+    assert METHOD_ACTIVATE == "fleet.session.activate"
+    assert METHOD_STATUS == "fleet.session.status"
+    assert METHOD_DEACTIVATE == "fleet.session.deactivate"
+    assert METHOD_REPLAY == "fleet.session.replay"
+    assert EVENT_TYPES == frozenset({
+        "session.registered", "session.status_changed", "session.heartbeat",
+        "session.metadata_changed", "session.detached", "session.ended",
+    })
+    assert "replay_gap" in ERROR_CODES and "invalid_request" in ERROR_CODES
+
+
+# ── request parsing: closed {schema_version} ops ─────────────────────────────
+
+
+@pytest.mark.parametrize("parse", [parse_activate_request, parse_status_request, parse_deactivate_request])
+def test_closed_single_field_requests_accept_only_schema_version(parse):
+    assert parse({"schema_version": WIRE_SCHEMA}) == {"schema_version": WIRE_SCHEMA}
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse({"schema_version": WIRE_SCHEMA, "session_id": "sneaky"})
+    assert _code(exc) == "invalid_request"
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse({"schema_version": WIRE_SCHEMA, "owner_ref": "sneaky"})
+    assert _code(exc) == "invalid_request"
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse({})
+    assert _code(exc) == "invalid_request"
+
+
+@pytest.mark.parametrize("parse", [parse_activate_request, parse_status_request, parse_deactivate_request])
+def test_requests_reject_wrong_schema_and_non_mapping(parse):
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse({"schema_version": "pd-fleet-tui:v2"})
+    assert _code(exc) == "unsupported_schema"
+    for bad in (None, "x", 7, []):
+        with pytest.raises(FleetTuiWireError) as exc:
+            parse(bad)
+        assert _code(exc) == "invalid_request"
+
+
+def test_replay_request_requires_only_opaque_cursor():
+    assert parse_replay_request({"schema_version": WIRE_SCHEMA, "cursor": "cursor.abc-1"}) == {
+        "schema_version": WIRE_SCHEMA, "cursor": "cursor.abc-1",
+    }
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse_replay_request({"schema_version": WIRE_SCHEMA})
+    assert _code(exc) == "invalid_request"
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse_replay_request({"schema_version": WIRE_SCHEMA, "cursor": "cursor.abc-1", "sequence": 4})
+    assert _code(exc) == "invalid_request"
+    with pytest.raises(FleetTuiWireError) as exc:
+        parse_replay_request({"schema_version": WIRE_SCHEMA, "cursor": ""})
+    assert _code(exc) == "invalid_request"
+
+
+# ── opaque ref rules (redaction escape attempts) ─────────────────────────────
+
+
+@pytest.mark.parametrize("bad_ref", [
+    "", "has space", "control\x01char", "pi\u202ebidi", "x" * 129,
+    "my-secret-ref", "access-token-1", "userapikey", "private_key_2", "session-history",
+])
+def test_refs_reject_sensitive_or_malformed_values(bad_ref):
+    with pytest.raises(FleetTuiWireError) as exc:
+        build_snapshot(association_ref=bad_ref, stream_epoch=REF2, snapshot_sequence=1,
+                       boundary_ref=REF, state="observing", metadata_version=1)
+    assert _code(exc) in {"invalid_request", "invalid_event", "invalid_provenance"}
+
+
+def test_refs_accept_bounded_opaque_values():
+    snap = build_snapshot(association_ref=REF, stream_epoch="epoch.7", snapshot_sequence=0,
+                          boundary_ref="boundary.x", state="observing", metadata_version=1)
+    assert snap == {
+        "association_ref": REF, "stream_epoch": "epoch.7", "snapshot_sequence": 0,
+        "boundary_ref": "boundary.x", "state": "observing", "metadata_version": 1,
+    }
+
+
+# ── snapshot / responses ─────────────────────────────────────────────────────
+
+
+def _snap(**over):
+    base = dict(association_ref=REF, stream_epoch="epoch.7", snapshot_sequence=3,
+                boundary_ref="boundary.x", state="observing", metadata_version=1)
+    base.update(over)
+    return build_snapshot(**base)
+
+
+def test_snapshot_is_closed_no_arbitrary_metadata():
+    with pytest.raises(FleetTuiWireError) as exc:
+        build_snapshot(association_ref=REF, stream_epoch="e", snapshot_sequence=1, boundary_ref="b",
+                       state="observing", metadata_version=1, prompt="leak me")
+    assert _code(exc) == "invalid_request"
+    with pytest.raises(FleetTuiWireError):
+        _snap(snapshot_sequence=True)
+    with pytest.raises(FleetTuiWireError):
+        _snap(metadata_version=-1)
+
+
+def test_activate_response_shape_and_bounds():
+    resp = build_activate_response(
+        association_ref=REF, subscriber_ref=REF2, stream_epoch="epoch.7",
+        cursor="cursor.1", snapshot=_snap(),
+    )
+    assert set(resp) == {"schema_version", "association_ref", "subscriber_ref", "stream_epoch", "cursor", "snapshot"}
+    assert resp["schema_version"] == WIRE_SCHEMA
+    assert len(json.dumps(resp).encode()) < MAX_ENVELOPE_BYTES
+
+
+def test_status_and_deactivate_response_shapes():
+    assert build_status_response(snapshot=_snap()) == {"schema_version": WIRE_SCHEMA, "snapshot": _snap()}
+    assert build_deactivate_response() == {"schema_version": WIRE_SCHEMA, "status": "detached"}
+
+
+def test_replay_response_bounds_and_shape():
+    event = build_event_envelope(
+        event_id="evt.1", event_type="session.heartbeat", association_ref=REF,
+        stream_epoch="epoch.7", sequence=4, payload={"status": "observing", "metadata_version": 1},
+    )
+    resp = build_replay_response(events=[event], next_cursor="cursor.2")
+    assert set(resp) == {"schema_version", "events", "next_cursor"}
+    assert resp["next_cursor"] == "cursor.2"
+    empty = build_replay_response(events=[], next_cursor=None)
+    assert empty["events"] == [] and empty["next_cursor"] is None
+    with pytest.raises(FleetTuiWireError) as exc:
+        build_replay_response(events=[event] * (MAX_REPLAY_EVENTS + 1), next_cursor=None)
+    assert _code(exc) == "payload_too_large"
+
+
+# ── event envelope ───────────────────────────────────────────────────────────
+
+
+def _event(**over):
+    base = dict(event_id="evt.1", event_type="session.status_changed", association_ref=REF,
+                stream_epoch="epoch.7", sequence=4, payload={"status": "observing", "reason_code": "heartbeat_timeout", "metadata_version": 1})
+    base.update(over)
+    return build_event_envelope(**base)
+
+
+def test_event_envelope_is_closed():
+    env = _event()
+    assert set(env) == {"schema_version", "event_id", "event_type", "association_ref", "stream_epoch", "sequence", "payload"}
+    assert env["schema_version"] == WIRE_SCHEMA
+    with pytest.raises(FleetTuiWireError) as exc:
+        _event(event_type="session.exfiltrated")
+    assert _code(exc) == "invalid_event"
+    with pytest.raises(FleetTuiWireError) as exc:
+        _event(payload={"status": "observing", "metadata_version": 1, "prompt": "leak"})
+    assert _code(exc) == "invalid_event"
+    with pytest.raises(FleetTuiWireError) as exc:
+        _event(payload={"status": "not_a_state", "metadata_version": 1})
+    assert _code(exc) == "invalid_event"
+    with pytest.raises(FleetTuiWireError) as exc:
+        _event(sequence=True)
+    assert _code(exc) == "invalid_event"
+
+
+def test_event_payload_bounds_and_redaction():
+    with pytest.raises(FleetTuiWireError) as exc:
+        _event(payload={"status": "observing", "metadata_version": 1, "nested": {"a": 1}})
+    assert _code(exc) == "invalid_event"
+    assert len(json.dumps(_event()).encode()) < MAX_PAYLOAD_BYTES
+
+
+# ── canonical errors ─────────────────────────────────────────────────────────
+
+
+def test_build_error_uses_canonical_closed_codes():
+    err = build_error("replay_gap")
+    assert err == {"schema_version": WIRE_SCHEMA, "error": {"code": "replay_gap"}}
+    for code in ERROR_CODES:

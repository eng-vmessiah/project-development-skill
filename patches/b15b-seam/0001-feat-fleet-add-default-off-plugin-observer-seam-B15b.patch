+++ b/tui_gateway/plugin_observer.py
@@ -0,0 +1,107 @@
+"""Default-off, namespaced observer registration and outbound event fan-out.
+
+Sibling of ``plugin_rpc.py`` (same namespace/identifier discipline, atomic
+batch registration, ``enabled`` flag required).  The bridge publisher is
+outbound: there is no request that "discovers" registrations — the composition
+root registers observers once at boot under ``pd_fleet_gateway_enabled``;
+without the flag this registry stays empty and ``publish`` is a no-op.
+
+Read-only by construction: observers receive redacted lifecycle events only.
+This module never dispatches, mutates sessions, or opens network routes.
+"""
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+import logging
+from typing import Any
+
+from .plugin_rpc import PluginRpcRegistrationError, validate_plugin_rpc
+
+logger = logging.getLogger(__name__)
+
+#: Frozen bridge wire schema (B15B seam contract §2/§4).
+BRIDGE_WIRE_SCHEMA = "pd-fleet-gateway-bridge:v1"
+
+ObserverHandler = Callable[..., None]
+
+
+class PluginObserverRegistry:
+    """Small registry whose caller must explicitly pass the integration flag."""
+
+    def __init__(self) -> None:
+        self._observers: dict[str, ObserverHandler] = {}
+
+    def register_batch(
+        self,
+        namespace: Any,
+        registrations: Any,
+        *,
+        enabled: bool = False,
+        reserved: set[str] | frozenset[str] = frozenset(),
+    ) -> tuple[str, ...]:
+        """Atomically register ``(name, handler)`` observer pairs.
+
+        Every entry is validated before the registry changes; the complete
+        candidate mapping is published by one reference swap, so a concurrent
+        publisher observes either the old or the new mapping, never a partial
+        batch.
+        """
+        if enabled is not True:
+            raise PluginRpcRegistrationError("plugin observer registration disabled")
+        # Validate the namespace even for an empty batch.
+        validate_plugin_rpc(namespace, "batch")
+        try:
+            entries = tuple(registrations)
+        except TypeError as exc:
+            raise PluginRpcRegistrationError("observer registrations must be iterable") from exc
+        validated: list[tuple[str, ObserverHandler]] = []
+        batch_names: set[str] = set()
+        for registration in entries:
+            if not isinstance(registration, (tuple, list)) or len(registration) != 2:
+                raise PluginRpcRegistrationError(
+                    "observer registration must be a (name, handler) pair"
+                )
+            name, handler = registration
+            method = validate_plugin_rpc(namespace, name)
+            if not callable(handler):
+                raise PluginRpcRegistrationError("observer handler must be callable")
+            if method in reserved:
+                raise PluginRpcRegistrationError("observer namespace collision")
+            if method in self._observers:
+                raise PluginRpcRegistrationError("duplicate plugin observer")
+            if method in batch_names:
+                raise PluginRpcRegistrationError("duplicate plugin observer in batch")
+            batch_names.add(method)
+            validated.append((method, handler))
+        published = dict(self._observers)
+        for method, handler in validated:
+            published[method] = handler
+        self._observers = published
+        return tuple(method for method, _handler in validated)
+
+    @property
+    def methods(self) -> tuple[str, ...]:
+        return tuple(sorted(self._observers))
+
+    def publish(self, event: Mapping[str, Any], *, principal: Any = None) -> int:
+        """Fan out one event to every registered observer; returns deliveries.
+
+        Contained failure: a raising handler never breaks the gateway loop,
+        other observers, or this call.  Malformed events or unsupported schema
+        versions deliver nothing (fail-closed) — no fallback, no partial claim.
+        """
+        if not self._observers:
+            return 0
+        if not isinstance(event, Mapping) or event.get("schema_version") != BRIDGE_WIRE_SCHEMA:
+            logger.debug("observer publish skipped: unsupported or malformed event")
+            return 0
+        payload = dict(event)
+        delivered = 0
+        for method, handler in sorted(self._observers.items()):
+            try:
+                handler(payload, principal=principal)
+            except Exception:  # contained: never propagates to the gateway loop
+                logger.warning("observer handler failed: %s", method)
+                continue
+            delivered += 1
+        return delivered

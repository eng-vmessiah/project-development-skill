+"""Fixtures for the B15b.1 observer seam (B15B-SEAM-CONTRACT §6).
+
+Proves: default-off no-op publishing, enabled-flag requirement, atomic batch
+registration, namespace/duplicate rejections, handler exception isolation,
+fail-closed schema versioning, and non-Fleet compatibility.
+"""
+from __future__ import annotations
+
+import pytest
+
+from tui_gateway.plugin_observer import BRIDGE_WIRE_SCHEMA, PluginObserverRegistry
+from tui_gateway.plugin_rpc import PluginRpcRegistrationError
+
+EVENT = {"schema_version": BRIDGE_WIRE_SCHEMA, "event_type": "session.heartbeat"}
+
+
+def _noop(event, **kwargs):
+    return None
+
+
+def test_default_off_no_handlers() -> None:
+    registry = PluginObserverRegistry()
+    assert registry.methods == ()
+    assert registry.publish(EVENT) == 0  # no-op: nothing registered, nothing delivered
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("fleet", (("bridge_observer", _noop),), enabled=False)
+    assert registry.methods == ()
+
+
+def test_config_absent_disabled_invalid() -> None:
+    registry = PluginObserverRegistry()
+    for enabled in (False, None, "yes", 1):
+        with pytest.raises(PluginRpcRegistrationError):
+            registry.register_batch("fleet", (), enabled=enabled)
+    assert registry.register_batch("fleet", (), enabled=True) == ()  # empty batch valid
+    assert registry.methods == ()
+
+
+def test_namespace_rejections() -> None:
+    registry = PluginObserverRegistry()
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("other", (), enabled=True)  # namespace must be exactly "fleet"
+    for bad_name in ("Bad", "has-dash", "1start", "end.", "a..b", ""):
+        with pytest.raises(PluginRpcRegistrationError):
+            registry.register_batch("fleet", ((bad_name, _noop),), enabled=True)
+    registry.register_batch("fleet", (("obs", _noop),), enabled=True)
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("fleet", (("obs", _noop),), enabled=True)  # duplicate
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("fleet", (("obs2", _noop),), enabled=True, reserved={"fleet.obs2"})
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("fleet", (("dup", _noop), ("dup", _noop)), enabled=True)
+    assert registry.methods == ("fleet.obs",)
+
+
+def test_batch_is_atomic_on_failure() -> None:
+    registry = PluginObserverRegistry()
+    with pytest.raises(PluginRpcRegistrationError):
+        registry.register_batch("fleet", (("ok_one", _noop), ("Bad", _noop)), enabled=True)
+    assert registry.methods == ()  # failed batch published nothing
+
+
+def test_handler_exception_isolated() -> None:
+    calls: list[str] = []
+
+    def bad(event, **kwargs):
+        calls.append("bad")
+        raise RuntimeError("boom")
+
+    def good(event, **kwargs):
+        calls.append("good")
+
+    registry = PluginObserverRegistry()
+    registry.register_batch("fleet", (("bad_obs", bad), ("good_obs", good)), enabled=True)
+    assert registry.publish(EVENT) == 1  # good delivered; bad contained
+    assert calls == ["bad", "good"]
+
+
+def test_version_unsupported_fails_closed() -> None:
+    received: list[dict] = []
+    registry = PluginObserverRegistry()
+    registry.register_batch(
+        "fleet", (("obs", lambda event, **kwargs: received.append(event)),), enabled=True
+    )
+    assert registry.publish({"schema_version": "pd-fleet-gateway-bridge:v2"}) == 0
+    assert registry.publish({"event_type": "session.heartbeat"}) == 0  # missing version
+    assert registry.publish("not-a-mapping") == 0
+    assert received == []
+    assert registry.publish(EVENT) == 1
+    assert received and received[0]["schema_version"] == BRIDGE_WIRE_SCHEMA
+
+
+def test_golden_non_fleet_registry_untouched() -> None:
+    from tui_gateway.plugin_rpc import PluginRpcRegistry
+
+    rpc = PluginRpcRegistry()
+    rpc.register("fleet", "session_probe", lambda *args, **kwargs: {}, enabled=True)
+    observers = PluginObserverRegistry()
+    observers.register_batch("fleet", (("obs", _noop),), enabled=True)
+    assert observers.publish(EVENT) == 1
+    assert rpc.resolve("fleet.session_probe") is not None  # non-Fleet surface untouched
+    assert observers.methods == ("fleet.obs",)

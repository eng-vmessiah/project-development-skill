--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -15,7 +15,7 @@ import time
 import uuid
 from datetime import datetime
 from pathlib import Path
-from typing import Any, Optional
+from typing import Any, Callable, Optional
 
 from hermes_constants import (
     get_hermes_home,
@@ -1217,6 +1217,68 @@ def method(name: str):
     return dec
 
 
+_plugin_rpc_handlers: dict[str, Callable] = {}
+_plugin_rpc_lock = threading.RLock()
+
+
+def register_plugin_rpcs(manager) -> None:
+    """Publish staged plugin RPCs into the host-owned TUI registry."""
+    with _plugin_rpc_lock:
+        entries = list(getattr(manager, "_tui_rpcs", []))
+        validated: list[tuple[str, Callable]] = []
+        seen: set[str] = set()
+        for entry in entries:
+            if not isinstance(entry, dict):
+                raise ValueError("invalid plugin TUI RPC registration")
+            name = entry.get("name")
+            handler = entry.get("handler")
+            if (
+                not isinstance(name, str)
+                or not name.startswith("pd-fleet.")
+                or name.endswith(".")
+                or ".." in name
+                or "/" in name
+                or any(
+                    not segment
+                    or any(not (char.isascii() and (char.isalnum() or char in "_-")) for char in segment)
+                    for segment in name.split(".")
+                )
+                or entry.get("plugin") != "pd-fleet"
+                or not callable(handler)
+                or name in seen
+            ):
+                raise ValueError("invalid plugin TUI RPC registration")
+            seen.add(name)
+            existing = _methods.get(name)
+            owned = _plugin_rpc_handlers.get(name)
+            if existing is not None and existing is not handler and existing is not owned:
+                raise ValueError(f"TUI RPC already registered: {name}")
+            validated.append((name, handler))
+
+        current_names = {name for name, _handler in validated}
+        for name, handler in list(_plugin_rpc_handlers.items()):
+            if name not in current_names and _methods.get(name) is handler:
+                del _methods[name]
+                del _plugin_rpc_handlers[name]
+        for name, handler in validated:
+            if _methods.get(name) is not handler:
+                _methods[name] = handler
+            _plugin_rpc_handlers[name] = handler
+
+
+def _load_plugin_rpcs() -> None:
+    """Lazily discover and publish PD Fleet RPCs on their first request."""
+    with _plugin_rpc_lock:
+        try:
+            from hermes_cli.plugins import discover_plugins, get_plugin_manager
+
+            discover_plugins()
+            register_plugin_rpcs(get_plugin_manager())
+        except Exception:
+            logger.warning("Plugin TUI RPC discovery failed", exc_info=True)
+
+
+
 def _normalize_request(req: Any) -> tuple[Any, str, dict] | dict:
     """Validate a JSON-RPC request enough for safe local dispatch."""
     if not isinstance(req, dict):
@@ -1243,6 +1305,9 @@ def handle_request(req: dict) -> dict | None:
 
     rid, method, params = normalized
     fn = _methods.get(method)
+    if fn is None and method.startswith("pd-fleet."):
+        _load_plugin_rpcs()
+        fn = _methods.get(method)
     if not fn:
         return _err(rid, -32601, f"unknown method: {method}")
     return fn(rid, params)

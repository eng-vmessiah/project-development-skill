diff --git a/tests/hermes_cli/test_tui_rpc_plugin_seam.py b/tests/hermes_cli/test_tui_rpc_plugin_seam.py
new file mode 100644
index 0000000000..b9d994739d
--- /dev/null
+++ b/tests/hermes_cli/test_tui_rpc_plugin_seam.py
@@ -0,0 +1,130 @@
+"""Red tests for the opt-in, lazy TUI RPC plugin seam."""
+
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+
+def _ctx(name: str = "pd-fleet"):
+    manager = PluginManager()
+    manager._discovered = True
+    return PluginContext(PluginManifest(name=name), manager), manager
+
+
+def test_plugin_context_stages_namespaced_tui_rpc():
+    ctx, manager = _ctx()
+
+    def handler(rid, params):
+        return {"jsonrpc": "2.0", "id": rid, "result": {"ok": True}}
+
+    ctx.register_tui_rpc("session.snapshot", handler)
+
+    assert manager._tui_rpcs == [
+        {
+            "name": "pd-fleet.session.snapshot",
+            "handler": handler,
+            "plugin": "pd-fleet",
+        }
+    ]
+
+
+def test_plugin_context_rejects_invalid_tui_rpc_registration():
+    ctx, _manager = _ctx("pd-fleet")
+
+    with pytest.raises(ValueError, match="non-empty relative name"):
+        ctx.register_tui_rpc("pd-fleet.session.snapshot", lambda *_: None)
+
+    with pytest.raises(ValueError, match="non-empty relative name"):
+        ctx.register_tui_rpc("session:snapshot", lambda *_: None)
+
+    with pytest.raises(ValueError, match="callable"):
+        ctx.register_tui_rpc("session.snapshot", None)
+
+
+def test_tui_rpc_registry_installs_only_plugin_namespace(monkeypatch):
+    from tui_gateway import server
+
+    ctx, manager = _ctx("pd-fleet")
+    handler = lambda rid, params: {"jsonrpc": "2.0", "id": rid, "result": params}
+    ctx.register_tui_rpc("session.snapshot", handler)
+    monkeypatch.setattr(server, "_methods", {"existing.method": object()})
+
+    server.register_plugin_rpcs(manager)
+
+    assert server._methods["pd-fleet.session.snapshot"] is handler
+    assert "existing.method" in server._methods
+
+
+def test_tui_rpc_registry_rejects_collisions(monkeypatch):
+    from tui_gateway import server
+
+    ctx, manager = _ctx("pd-fleet")
+    ctx.register_tui_rpc("session.snapshot", lambda *_: None)
+    monkeypatch.setattr(server, "_methods", {"pd-fleet.session.snapshot": object()})
+
+    with pytest.raises(ValueError, match="already registered"):
+        server.register_plugin_rpcs(manager)
+
+
+def test_tui_rpc_registry_validates_before_publishing(monkeypatch):
+    from tui_gateway import server
+
+    ctx, manager = _ctx("pd-fleet")
+    first = lambda *_: None
+    ctx.register_tui_rpc("first", first)
+    manager._tui_rpcs.append({"name": "pd-fleet.second", "handler": None, "plugin": "pd-fleet"})
+    monkeypatch.setattr(server, "_methods", {})
+
+    with pytest.raises(ValueError, match="invalid plugin"):
+        server.register_plugin_rpcs(manager)
+    assert "pd-fleet.first" not in server._methods
+
+
+def test_tui_rpc_registry_removes_stale_handlers_after_refresh(monkeypatch):
+    from tui_gateway import server
+
+    ctx, manager = _ctx("pd-fleet")
+    old = lambda *_: None
+    ctx.register_tui_rpc("old", old)
+    monkeypatch.setattr(server, "_methods", {})
+    server.register_plugin_rpcs(manager)
+
+    manager._tui_rpcs.clear()
+    server.register_plugin_rpcs(manager)
+
+    assert "pd-fleet.old" not in server._methods
+
+
+def test_tui_rpc_registry_replaces_owned_handler_on_refresh(monkeypatch):
+    from tui_gateway import server
+
+    ctx, manager = _ctx("pd-fleet")
+    old = lambda *_: None
+    new = lambda *_: None
+    ctx.register_tui_rpc("refresh", old)
+    monkeypatch.setattr(server, "_methods", {})
+    server.register_plugin_rpcs(manager)
+    manager._tui_rpcs[0]["handler"] = new
+    server.register_plugin_rpcs(manager)
+
+    assert server._methods["pd-fleet.refresh"] is new
+
+
+def test_failed_plugin_registration_discards_staged_tui_rpcs(monkeypatch):
+    from types import SimpleNamespace
+
+    manager = PluginManager()
+    manager._discovered = True
+    manifest = PluginManifest(name="pd-fleet", source="user", path="/tmp/pd-fleet")
+
+    def register(ctx):
+        ctx.register_tui_rpc("leaked", lambda *_: None)
+        raise RuntimeError("registration failed")
+
+    monkeypatch.setattr(manager, "_load_directory_module", lambda _manifest: SimpleNamespace(register=register))
+    manager._load_plugin(manifest)
+
+    assert manager._tui_rpcs == []
+    assert manager._plugins["pd-fleet"].enabled is False

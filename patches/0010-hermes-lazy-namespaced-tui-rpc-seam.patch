         self._manager._hooks.setdefault(hook_name, []).append(callback)
         logger.debug("Plugin %s registered hook: %s", self.manifest.name, hook_name)
 
+    def register_tui_rpc(self, relative_name: str, callback: Callable) -> None:
+        """Stage one namespaced, host-owned TUI JSON-RPC handler."""
+        if not isinstance(relative_name, str) or not relative_name.strip():
+            raise ValueError("TUI RPC name must be a non-empty relative name")
+        relative_name = relative_name.strip()
+        if (
+            relative_name.startswith(".")
+            or relative_name.endswith(".")
+            or relative_name.startswith(f"{self.manifest.name}.")
+            or ".." in relative_name
+            or "/" in relative_name
+            or any(
+                not segment
+                or any(not (char.isascii() and (char.isalnum() or char in "_-")) for char in segment)
+                for segment in relative_name.split(".")
+            )
+        ):
+            raise ValueError("TUI RPC name must be a non-empty relative name")
+        if not callable(callback):
+            raise ValueError("TUI RPC handler must be callable")
+        self._manager._tui_rpcs.append(
+            {"name": f"{self.manifest.name}.{relative_name}", "handler": callback, "plugin": self.manifest.name}
+        )
+        logger.debug("Plugin %s staged TUI RPC: %s.%s", self.manifest.name, self.manifest.name, relative_name)
+
     # -- middleware registration -------------------------------------------
 

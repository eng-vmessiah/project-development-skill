diff --git a/hermes_cli/fleet_session_bridge.py b/hermes_cli/fleet_session_bridge.py
new file mode 100644
index 0000000000..cbcef50ec0
--- /dev/null
+++ b/hermes_cli/fleet_session_bridge.py
@@ -0,0 +1,118 @@
+"""Fail-closed bridge from dashboard session cookies to fleet principals.
+
+This module deliberately keeps the dashboard access token at the request
+boundary.  It is passed to the configured verifier and is never interpreted,
+stored, or included in an exception or representation here.
+"""
+from __future__ import annotations
+
+from time import time
+from typing import Any, Callable, Mapping, Optional
+
+from .dashboard_auth.base import Session
+from .dashboard_auth.registry import list_session_providers
+from .fleet_activation import (
+    DashboardSessionFleetIdentityAdapter,
+    FleetActivationError,
+    FleetActivationNotReady,
+    FleetActivationOwner,
+    FleetPrincipal,
+)
+
+COOKIE_NAMES = (
+    "__Host-hermes_session_at",
+    "__Secure-hermes_session_at",
+    "hermes_session_at",
+)
+MAX_ACCESS_TOKEN_LENGTH = 4096
+
+
+def verify_registered_dashboard_session(access_token: str) -> Optional[Session]:
+    """Verify a cookie against registered session providers.
+
+    Provider failures are intentionally indistinguishable from an invalid
+    session.  In particular, the opaque token is not logged or copied into an
+    error while handling a provider exception.
+    """
+    if type(access_token) is not str or not access_token or len(access_token) > MAX_ACCESS_TOKEN_LENGTH:
+        return None
+    try:
+        providers = list_session_providers()
+    except Exception:
+        return None
+    for provider in providers:
+        try:
+            session = provider.verify_session(access_token=access_token)
+        except Exception:
+            continue
+        if type(session) is Session:
+            return session
+    return None
+
+
+class DashboardSessionRequestBridge:
+    """Resolve an explicitly verified dashboard cookie to an owned principal."""
+
+    def __init__(self, owner: FleetActivationOwner,
+                 verify_access_token: Callable[[str], Optional[Session]],
+                 clock: Callable[[], Any] | None = None) -> None:
+        if type(owner) is not FleetActivationOwner:
+            raise FleetActivationError("dashboard request bridge requires an exact FleetActivationOwner")
+        if not callable(verify_access_token):
+            raise FleetActivationError("dashboard request bridge requires a callable verifier")
+        if not owner.ready:
+            raise FleetActivationNotReady("dashboard request bridge owner is not ready")
+        if clock is not None and not callable(clock):
+            raise FleetActivationError("dashboard request bridge clock must be callable")
+        self._owner = owner
+        self._verify_access_token = verify_access_token
+        self._identity_adapter = DashboardSessionFleetIdentityAdapter(owner, clock=clock or time)
+
+    @property
+    def owner(self) -> FleetActivationOwner:
+        return self._owner
+
+    def resolve_cookies(self, cookies: Mapping[str, str]) -> Optional[FleetPrincipal]:
+        """Resolve only the supported session-cookie names, in strict order."""
+        if not isinstance(cookies, Mapping):
+            return None
+        values = []
+        try:
+            for name in COOKIE_NAMES:
+                if name in cookies:
+                    value = cookies[name]
+                    if type(value) is not str or not value or len(value) > MAX_ACCESS_TOKEN_LENGTH:
+                        return None
+                    values.append(value)
+        except Exception:
+            return None
+        if not values or len(set(values)) != 1:
+            return None
+        access_token = values[0]
+        try:
+            session = self._verify_access_token(access_token)
+        except Exception:
+            return None
+        if type(session) is not Session:
+            return None
+        try:
+            principal = self._identity_adapter.adapt(session)
+        except Exception:
+            return None
+        return principal if type(principal) is FleetPrincipal else None
+
+    def resolve_request(self, request: Any) -> Optional[FleetPrincipal]:
+        """Resolve ``request.cookies`` without inspecting any other request data."""
+        try:
+            cookies = request.cookies
+        except Exception:
+            return None
+        return self.resolve_cookies(cookies)
+
+
+__all__ = [
+    "COOKIE_NAMES",
+    "MAX_ACCESS_TOKEN_LENGTH",
+    "DashboardSessionRequestBridge",
+    "verify_registered_dashboard_session",
+]

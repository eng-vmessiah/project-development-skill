@@ -0,0 +1,96 @@
+from types import SimpleNamespace
+from typing import Any, cast
+
+import pytest
+
+from hermes_cli.dashboard_auth.base import Session, TokenPrincipal
+from hermes_cli.fleet_activation import FleetActivationError, FleetActivationNotReady, FleetActivationOwner
+from hermes_cli.fleet_session_bridge import (
+    DashboardSessionRequestBridge,
+    MAX_ACCESS_TOKEN_LENGTH,
+    verify_registered_dashboard_session,
+)
+
+
+def _session(user_id="owner", token="opaque"):
+    return Session(user_id, "owner@example.test", "Owner", "", "dashboard", 2_000, token, "refresh")
+
+
+def _bridge(verifier, clock=lambda: 1_000):
+    owner = FleetActivationOwner("api", "owner", enabled=True, wired=True)
+    owner.activate()
+    return DashboardSessionRequestBridge(owner, verifier, clock=clock)
+
+
+def test_cookie_precedence_and_session_adaptation():
+    seen = []
+    bridge = _bridge(lambda token: seen.append(token) or _session(token=token))
+    principal = bridge.resolve_cookies({"hermes_session_at": "fallback", "__Host-hermes_session_at": "preferred"})
+    assert principal is None  # conflicting aliases fail closed
+    assert seen == []
+    principal = bridge.resolve_cookies({"__Host-hermes_session_at": "preferred"})
+    assert principal is not None
+    assert principal.subject_ref == "owner"
+    assert seen == ["preferred"]
+
+
+def test_conflicting_empty_and_oversize_cookies_never_reach_verifier():
+    seen = []
+    bridge = _bridge(lambda token: seen.append(token))
+    assert bridge.resolve_cookies({"__Secure-hermes_session_at": "a", "hermes_session_at": "b"}) is None
+    assert bridge.resolve_cookies({"hermes_session_at": ""}) is None
+    assert bridge.resolve_cookies({"hermes_session_at": "x" * (MAX_ACCESS_TOKEN_LENGTH + 1)}) is None
+    assert seen == []
+
+
+def test_request_bridge_does_not_read_auth_body_or_query():
+    seen = []
+    bridge = _bridge(lambda token: seen.append(token) or _session(token=token))
+    request = SimpleNamespace(cookies={"hermes_session_at": "cookie"},
+                              headers={"Authorization": "Bearer header"},
+                              body="body", query={"token": "query"})
+    principal = bridge.resolve_request(request)
+    assert principal is not None
+    assert principal.subject_ref == "owner"
+    assert seen == ["cookie"]
+
+
+def test_token_principal_and_bad_verifier_results_fail_closed():
+    bridge = _bridge(lambda token: TokenPrincipal("service", "token"))
+    assert bridge.resolve_cookies({"hermes_session_at": "opaque"}) is None
+    bridge = _bridge(lambda token: (_ for _ in ()).throw(RuntimeError("opaque")))
+    assert bridge.resolve_cookies({"hermes_session_at": "opaque"}) is None
+
+
+def test_bridge_requires_exact_ready_owner_and_callable():
+    owner = FleetActivationOwner("api", "owner", enabled=True, wired=True)
+    with pytest.raises(FleetActivationNotReady):
+        DashboardSessionRequestBridge(owner, lambda token: None)
+    owner.activate()
+    with pytest.raises(FleetActivationError):
+        DashboardSessionRequestBridge(owner, cast(Any, None))
+
+
+def test_registered_provider_exception_fails_closed(monkeypatch):
+    class Provider:

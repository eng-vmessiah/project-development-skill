new file mode 100644
index 0000000000..1d043a9a35
--- /dev/null
+++ b/tests/hermes_cli/test_fleet_observer.py
@@ -0,0 +1,419 @@
+from __future__ import annotations
+
+import ast
+from datetime import datetime, timezone
+import math
+
+import pytest
+
+from hermes_cli.fleet_observer import (
+    FleetObserverConfig,
+    FleetObserverError,
+    FleetObserverHub,
+    FleetObserverNotReady,
+    FleetObserverScope,
+    ReplayGap,
+    fleet_observer_status,
+)
+
+
+SCOPE = FleetObserverScope("profile-a", "instance-a", "session-a")
+
+
+@pytest.mark.parametrize(
+    ("field", "values"),
+    [
+        ("enabled", [1, "true", None]),
+        ("replay_limit", [True, 0, 101, "10", None, -1]),
+        ("retention_ttl", [True, 0.0, -1.0, 86401.0, "3600", None, math.inf]),
+        ("diagnostic_limit", [True, 0, 101, "10", None, -1]),
+        ("max_streams", [True, 0, 1025, "10", None, -1]),
+        ("max_subscribers_per_stream", [True, 0, 1025, "10", None, -1]),
+    ],
+)
+def test_config_rejects_wrong_types_and_unbounded_values(field, values):
+    for value in values:
+        with pytest.raises(FleetObserverError):

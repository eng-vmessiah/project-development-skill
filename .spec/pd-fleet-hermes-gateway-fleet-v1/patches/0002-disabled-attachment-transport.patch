+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from hermes_cli.fleet_observer import FleetObserverConfig, FleetObserverHub, FleetObserverScope
+from hermes_cli.fleet_observer_transport import (
+    AUDIENCE, FleetObserverHTTPAdapter, FleetTicketBinding, FleetTransportConfig,
+    FleetTransportError, FleetTransportNotReady, SSEStream, create_internal_capability,
+    fleet_transport_status, issue_internal,
+)
+
+BINDING = FleetTicketBinding("observer", "owner", "profile", "workspace", "session", "association", "pd_observation", "user_owned_session")
+
+
+def ready():
+    config = FleetTransportConfig(enabled=True, max_sse_queue=2)
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True, replay_limit=3)); hub.activate()
+    capability = create_internal_capability(config, wired=True)
+    adapter = FleetObserverHTTPAdapter(hub, capability, wired=True, authenticate=lambda _: "observer")
+    return hub, capability, adapter
+
+
+def consume(adapter, token):
+    return adapter.handle({"method": "POST", "path": "/pd-fleet/v1/tickets/consume", "body": {"ticket": token}})
+
+
+def auth(response, token):
+    return {"method": "GET", "path": "/pd-fleet/v1/associations/association/{}/snapshot".format(""), "headers": {"Authorization": "Bearer " + token}}
+
+
+def test_enabled_alone_is_never_ready_and_all_routes_are_uniform_not_ready():
+    config = FleetTransportConfig(enabled=True)
+    assert fleet_transport_status(config) == {"enabled": True, "transport": "NOT_READY", "issuer": "NOT_READY"}
+    capability = create_internal_capability(config)
+    with pytest.raises(FleetTransportNotReady):
+        issue_internal(capability, BINDING)
+    adapter = FleetObserverHTTPAdapter(FleetObserverHub(), capability)
+    assert adapter.status()["transport"] == "NOT_READY"
+    response = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/x/snapshot"})
+    assert response.status == 404 and response.body == {"error": "NOT_READY"}
+
+
+def test_config_rejects_subclasses_nan_and_bad_bounds():
+    for kwargs in ({"enabled": 1}, {"ticket_ttl": True}, {"ticket_ttl": float("nan")}, {"max_active_tickets": 0}, {"max_active_tickets": 3, "max_total_tickets": 2}):
+        with pytest.raises(FleetTransportError): FleetTransportConfig(**kwargs)
+
+
+def test_internal_issue_boundary_opaque_binding_and_one_use():
+    _, capability, _ = ready()
+    token = issue_internal(capability, BINDING)
+    assert token and "observer" not in token and token != capability._issuer._digest(token)
+    consumed = capability._issuer.consume(token)
+    assert consumed.audience == AUDIENCE and consumed.binding == BINDING
+    with pytest.raises(FleetTransportError): capability._issuer.consume(token)
+    with pytest.raises(FleetTransportError): FleetObserverHTTPAdapter(FleetObserverHub(), capability).issue_ticket(BINDING)
+
+
+def test_ticket_active_cap_and_concurrent_consume():
+    config = FleetTransportConfig(enabled=True, max_active_tickets=1, max_total_tickets=2)
+    cap = create_internal_capability(config, wired=True)
+    first = issue_internal(cap, BINDING)
+    with pytest.raises(FleetTransportError): issue_internal(cap, BINDING)
+    results = []
+    with ThreadPoolExecutor(max_workers=16) as pool:
+        results = list(pool.map(lambda _: _consume(cap, first), range(32)))
+    assert sum(results) == 1
+    issue_internal(cap, BINDING)
+
+
+def _consume(cap, token):
+    try: cap._issuer.consume(token); return True
+    except FleetTransportError: return False
+
+
+def test_http_never_accepts_python_binding_claims_and_registration_is_not_ready():
+    hub, cap, adapter = ready()
+    token = issue_internal(cap, BINDING)
+    assert adapter.handle({"method": "POST", "path": "/pd-fleet/v1/tickets/consume", "body": {"ticket": token, "binding": BINDING}}).status == 400
+    assert adapter.handle({"method": "POST", "path": "/pd-fleet/v1/observers/register", "body": {"observer_ref": "observer"}}).body == {"error": "NOT_READY"}
+
+
+def test_wrong_principal_cannot_burn_ticket_before_rightful_consume():
+    hub, cap, _ = ready()
+    principal = ["wrong"]
+    adapter = FleetObserverHTTPAdapter(hub, cap, wired=True, authenticate=lambda _: principal[0])
+    token = issue_internal(cap, BINDING)
+
+    rejected = consume(adapter, token)
+    assert rejected.status == 403 and rejected.body == {"error": "request unavailable"}
+
+    principal[0] = "observer"
+    attached = consume(adapter, token)
+    assert attached.status == 200
+
+
+def test_attachment_required_principal_and_association_scope():
+    hub, cap, adapter = ready(); token = issue_internal(cap, BINDING)
+    assert adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/snapshot", "headers": {}}).status == 401
+    attached = consume(adapter, token); assert attached.status == 200
+    attachment = attached.body["attachment_token"]
+    req = {"method": "GET", "path": "/pd-fleet/v1/associations/association/snapshot", "headers": {"Authorization": "Bearer " + attachment}}
+    assert adapter.handle(req).status == 200
+    req["path"] = "/pd-fleet/v1/associations/other/snapshot"
+    assert adapter.handle(req).status == 401
+
+
+def test_snapshot_cursor_and_gap_are_explicit():
+    hub, cap, adapter = ready(); token = issue_internal(cap, BINDING); attached = consume(adapter, token)
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    scope = FleetObserverScope("profile", "workspace", "session", "association")
+    for _ in range(4): hub.publish("session.heartbeat", scope, {"status": "ok"})
+    response = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/snapshot", "headers": bearer})
+    assert len(response.body["events"]) <= 3 and response.body["next_cursor"].count(":") == 1
+    bad = dict(bearer); bad["Last-Event-ID"] = "bad"
+    assert adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/snapshot", "headers": bad}).status == 409
+
+
+def test_sse_complete_serialization_overflow_and_close_unsubscribes():
+    hub, cap, adapter = ready(); token = issue_internal(cap, BINDING); attached = consume(adapter, token)
+    bearer = "Bearer " + attached.body["attachment_token"]
+    stream = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/stream", "headers": {"Authorization": bearer}})
+    assert isinstance(stream, SSEStream) and stream.headers["Content-Type"] == "text/event-stream"
+    scope = FleetObserverScope("profile", "workspace", "session", "association")
+    hub.publish("session.heartbeat", scope, {"status": "ok"}); hub.publish("session.heartbeat", scope, {"status": "ok"}); hub.publish("session.heartbeat", scope, {"status": "ok"})
+    assert stream.overflow and '"overflow"' in stream.read()[0]
+    stream.close(); assert not hub._subscribers
+
+
+def test_replacing_sse_closes_old_before_subscribing_with_single_subscriber_capacity():
+    config = FleetTransportConfig(enabled=True, max_sse_queue=2)
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True, max_subscribers_per_stream=1)); hub.activate()
+    cap = create_internal_capability(config, wired=True)
+    adapter = FleetObserverHTTPAdapter(hub, cap, wired=True, authenticate=lambda _: "observer")
+    attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    request = {"method": "GET", "path": "/pd-fleet/v1/associations/association/stream", "headers": bearer}
+    first = adapter.handle(request)
+    second = adapter.handle(request)
+    assert isinstance(first, SSEStream) and isinstance(second, SSEStream)
+    assert first.read() == ()
+    assert len(hub._subscribers) == 1
+    second.close()
+    assert not hub._subscribers
+
+
+def test_closed_sse_discards_buffered_events():
+    hub, cap, adapter = ready(); attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    stream = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/stream", "headers": bearer})
+    scope = FleetObserverScope("profile", "workspace", "session", "association")
+    hub.publish("session.heartbeat", scope, {"status": "buffered"})
+    stream.close()
+    assert stream.read() == ()
+    assert len(hub._subscribers) == 0
+
+
+def test_revocation_closes_stream_and_discards_buffered_events():
+    hub, cap, adapter = ready(); attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    stream = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/stream", "headers": bearer})
+    scope = FleetObserverScope("profile", "workspace", "session", "association")
+    hub.publish("session.heartbeat", scope, {"status": "buffered"})
+    assert adapter.handle({"method": "POST", "path": "/pd-fleet/v1/associations/association/detach", "headers": bearer}).status == 200
+    assert stream.read() == ()
+    assert not hub._subscribers
+
+
+def test_open_sse_expires_lazily_before_publish_without_handle_request():
+    now = [0.0]
+    config = FleetTransportConfig(enabled=True, attachment_ttl=1, max_sse_queue=2)
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True)); hub.activate()
+    cap = create_internal_capability(config, wired=True, clock=lambda: now[0])
+    adapter = FleetObserverHTTPAdapter(hub, cap, wired=True, authenticate=lambda _: "observer")
+    attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    stream = adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/association/stream", "headers": bearer})
+    scope = FleetObserverScope("profile", "workspace", "session", "association")
+
+    now[0] = 2.0
+    hub.publish("session.heartbeat", scope, {"status": "late"})
+
+    assert stream._closed
+    assert not hub._subscribers
+    assert stream.read() == ()
+
+
+def test_attachment_expiry_and_detach_revoke_access():
+    now = [0.0]
+    config = FleetTransportConfig(enabled=True, attachment_ttl=1)
+    hub = FleetObserverHub(FleetObserverConfig(enabled=True)); hub.activate()
+    cap = create_internal_capability(config, wired=True, clock=lambda: now[0])
+    adapter = FleetObserverHTTPAdapter(hub, cap, wired=True, authenticate=lambda _: "observer")
+    attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    path = "/pd-fleet/v1/associations/association/snapshot"
+    assert adapter.handle({"method": "GET", "path": path, "headers": bearer}).status == 200
+    now[0] = 2
+    assert adapter.handle({"method": "GET", "path": path, "headers": bearer}).status == 401
+    attached = consume(adapter, issue_internal(cap, BINDING))
+    bearer = {"Authorization": "Bearer " + attached.body["attachment_token"]}
+    assert adapter.handle({"method": "POST", "path": "/pd-fleet/v1/associations/association/detach", "headers": bearer}).status == 200
+    assert adapter.handle({"method": "GET", "path": path, "headers": bearer}).status == 401
+
+
+def test_http_boundary_and_forbidden_routes():
+    _, cap, adapter = ready()
+    assert adapter.handle({"method": "GET", "path": "/pd-fleet/v1/associations/x/snapshot", "body": {}}).status == 400
+    assert adapter.handle({"method": "PUT", "path": "/pd-fleet/v1/associations/x/snapshot"}).status == 401
+    routes = " ".join(adapter.routes)
+    for forbidden in ("/api/events", "/v1/runs/", "credentials", "prompt", "history", "control"):
+        assert forbidden not in routes

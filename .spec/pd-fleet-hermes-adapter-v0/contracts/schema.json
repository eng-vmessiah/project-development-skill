{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pd-fleet-hermes-adapter:v0/request",
  "title": "PD Fleet Hermes Adapter v0 wire request",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/PrepareRequest"},
    {"$ref": "#/$defs/ExecuteRequest"},
    {"$ref": "#/$defs/ObserveRequest"},
    {"$ref": "#/$defs/CancelRequest"},
    {"$ref": "#/$defs/HandoffRequest"},
    {"$ref": "#/$defs/CleanupRequest"}
  ],
  "$defs": {
    "SafeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "Generation": {"type": "integer", "minimum": 0},
    "Lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "task_id", "attempt_id", "session_handle_id", "workspace_id"],
      "properties": {
        "run_id": {"$ref": "#/$defs/SafeId"},
        "task_id": {"$ref": "#/$defs/SafeId"},
        "attempt_id": {"$ref": "#/$defs/SafeId"},
        "session_handle_id": {"oneOf": [{"$ref": "#/$defs/SafeId"}, {"type": "null"}]},
        "workspace_id": {"$ref": "#/$defs/SafeId"}
      }
    },
    "MutatingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"type": "string"},
        "lineage": {"$ref": "#/$defs/Lineage"},
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"}
      }
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "root_ref", "isolation", "cleanup_policy"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/SafeId"},
        "root_ref": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*[\\x00-\\x1f\\x7f])[a-z0-9][a-z0-9._-]{0,127}$"},
        "isolation": {"const": "dedicated"},
        "cleanup_policy": {"const": "always"}
      }
    },
    "PrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint", "workspace"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "prepare"},
        "lineage": {"$ref": "#/$defs/Lineage"},
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"},
        "workspace": {"$ref": "#/$defs/Workspace"}
      }
    },
    "ExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint", "input"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "execute"},
        "lineage": {"allOf": [{"$ref": "#/$defs/Lineage"}, {"properties": {"session_handle_id": {"$ref": "#/$defs/SafeId"}}}]},
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal_ref", "payload"],
          "properties": {
            "goal_ref": {"$ref": "#/$defs/SafeId"},
            "payload": {"type": "string", "maxLength": 8192, "pattern": "^[^\\x00-\\x1f\\x7f]*$"}
          }
        }
      }
    },
    "ObserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "cursor"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "observe"},
        "lineage": {
          "allOf": [
            {"$ref": "#/$defs/Lineage"},
            {"properties": {"session_handle_id": {"$ref": "#/$defs/SafeId"}}}
          ]
        },
        "cursor": {"oneOf": [{"$ref": "#/$defs/SafeId"}, {"type": "null"}]}
      }
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint", "cancel_reason"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "cancel"},
        "lineage": {
          "allOf": [
            {"$ref": "#/$defs/Lineage"},
            {"properties": {"session_handle_id": {"$ref": "#/$defs/SafeId"}}}
          ]
        },
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"},
        "cancel_reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$"}
      }
    },
    "HandoffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint", "handoff_reason"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "handoff"},
        "lineage": {
          "allOf": [
            {"$ref": "#/$defs/Lineage"},
            {"properties": {"session_handle_id": {"$ref": "#/$defs/SafeId"}}}
          ]
        },
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"},
        "handoff_reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$"}
      }
    },
    "CleanupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "lineage", "owner", "expected_generation", "idempotency_key", "request_fingerprint", "cleanup_reason"],
      "properties": {
        "schema_version": {"const": "pd-fleet-hermes-adapter:v0"},
        "operation": {"const": "cleanup"},
        "lineage": {
          "allOf": [
            {"$ref": "#/$defs/Lineage"},
            {"properties": {"session_handle_id": {"$ref": "#/$defs/SafeId"}}}
          ]
        },
        "owner": {"$ref": "#/$defs/SafeId"},
        "expected_generation": {"$ref": "#/$defs/Generation"},
        "idempotency_key": {"$ref": "#/$defs/SafeId"},
        "request_fingerprint": {"$ref": "#/$defs/Fingerprint"},
        "cleanup_reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$"}
      }
    }
  }
}
